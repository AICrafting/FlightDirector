#!/usr/bin/env bash
#
# Forgejo CI adapter — verbs: watch log.  The two operations MCP can't do.
# See ../../../references/adapter-contract.md.
set -euo pipefail
ADAPTER_NAME="forgejo/ci"
# shellcheck source-path=SCRIPTDIR source=_common.sh
source "$(cd "$(dirname "$0")" && pwd)/_common.sh"

verb="${1:-}"; shift || true

case "$verb" in
  # Stream one line per CI state change for a commit, exit on a terminal state.
  # Background-friendly for the Monitor tool. Resilient: a transient API/jq blip
  # is swallowed and the poll continues, rather than killing the watcher.
  watch)
    sha=""; pr=""; status_file=""; timeout="${LS_CI_WATCH_TIMEOUT:-900}"
    while [ $# -gt 0 ]; do case "$1" in
      --sha)         sha="$2"; shift 2 ;;
      --pr)          pr="$2"; shift 2 ;;
      --status-file) status_file="$2"; shift 2 ;;
      --timeout)     timeout="$2"; shift 2 ;;
      *) die "ci watch: unknown arg '$1'" ;;
    esac; done
    # --pr is authoritative: the PR head commit IS the SHA the run reports as
    # head_sha. Prefer it over a caller-supplied --sha, which may be a *local*
    # tip that was never pushed — CI only ever runs on pushed commits, so
    # watching an unpushed SHA finds no run and polls forever (that was the bug).
    if [ -n "$pr" ]; then
      sha="$(_api GET "/pulls/${pr}" | jq -r '.head.sha // empty')"
      [ -n "$sha" ] || die "ci watch: could not resolve head sha for PR #${pr}"
    fi
    [ -n "$sha" ] || die "ci watch: --sha or --pr required"

    _write() {
      [ -n "$status_file" ] || return 0
      mkdir -p "$(dirname "$status_file")"
      printf '{"sha":"%s","status":"%s"}\n' "$sha" "$1" >"$status_file"
    }

    poll="${LS_CI_POLL_SECONDS:-30}"
    start="$(date +%s)"; seen=0; last_sig=""
    while true; do
      # /actions/runs (not /actions/tasks): a task only exists once a runner has
      # picked the job up, so a run still `waiting` is invisible to the tasks
      # endpoint and used to read as "no CI run found" (#53). Runs are listed
      # the moment they're created; the server filters by head_sha, but run
      # objects carry the commit as commit_sha.
      # ?head_sha= is an exact match — only usable for a full 40-char SHA; a
      # short prefix falls back to the unfiltered list + the startswith below.
      filter=""; [ "${#sha}" -eq 40 ] && filter="head_sha=${sha}&"
      body="$(curl -sS -H "Authorization: token ${LS_TOKEN}" \
        "${REPO_API}/actions/runs?${filter}limit=20" 2>/dev/null || true)"
      # Aggregate over ALL runs for this SHA (a PR can trigger several): keep
      # watching while any is pending; once none are pending the verdict is
      # failure if any run failed, else success. total/pending/failed on one line.
      metrics="$(printf '%s' "$body" | jq -r --arg sha "$sha" '
        [.workflow_runs[]? | select((.commit_sha // .head_sha // "")|startswith($sha)) | .status] as $s
        | ($s|length) as $total
        | ([$s[] | select(. as $x | ["waiting","running","queued","in_progress","blocked","unknown",""] | index($x))] | length) as $pending
        | ([$s[] | select((. as $x | ["waiting","running","queued","in_progress","blocked","unknown",""] | index($x)) | not)
                 | select((. as $x | ["success","skipped"] | index($x)) | not)] | length) as $failed
        | "\($total) \($pending) \($failed)"' 2>/dev/null || true)"
      read -r total pending failed <<<"$metrics" || true
      total="${total:-0}"; pending="${pending:-0}"; failed="${failed:-0}"
      if [ "$total" -gt 0 ]; then
        seen=1
        if [ "$pending" -gt 0 ]; then agg=pending; elif [ "$failed" -gt 0 ]; then agg=failure; else agg=success; fi
        sig="${total}/${pending}/${failed}"
        if [ "$sig" != "$last_sig" ]; then
          echo "ci runs=${total} pending=${pending} failed=${failed} status=${agg}"
          last_sig="$sig"; _write "$agg"
        fi
        [ "$pending" -eq 0 ] && exit 0
      fi
      # Hang guard: never poll forever. --timeout 0 disables the cap.
      if [ "$timeout" -gt 0 ] && [ "$(( $(date +%s) - start ))" -ge "$timeout" ]; then
        if [ "$seen" = 1 ]; then
          die "ci watch: timed out after ${timeout}s waiting for run ${sha:0:12} to reach a terminal state"
        else
          die "ci watch: timed out after ${timeout}s — no CI run found for ${sha:0:12} (is the branch pushed and does a workflow trigger for it?)"
        fi
      fi
      sleep "$poll"
    done
    ;;

  # Dump the failed jobs' logs for a commit (or the latest failed run on a
  # branch). Forgejo 16's Actions API serves per-job plaintext logs
  # (/actions/jobs/{id}/logs) — jobs are listed per run, failed ones dumped.
  log)
    sha=""; branch=""
    while [ $# -gt 0 ]; do case "$1" in
      --sha)    sha="$2"; shift 2 ;;
      --failed) branch="$2"; shift 2 ;;
      *) die "ci log: unknown arg '$1'" ;;
    esac; done
    [ -n "$sha" ] || [ -n "$branch" ] || die "ci log: --sha SHA or --failed BRANCH required"

    if [ -n "$sha" ]; then
      # ?head_sha= is an exact match — only usable for a full 40-char SHA; the
      # client-side startswith keeps short prefixes working (and harmlessly
      # re-checks the full-SHA case).
      filter=""; [ "${#sha}" -eq 40 ] && filter="head_sha=${sha}&"
      run="$(_api GET "/actions/runs?${filter}limit=20" \
        | jq -c --arg sha "$sha" '[.workflow_runs[]? | select((.commit_sha // "")|startswith($sha))]
          | sort_by(.started // .created) | last // empty')"
    else
      run="$(_api GET "/actions/runs?ref=refs/heads/${branch}&status=failure&limit=1" \
        | jq -c '.workflow_runs[0] // empty')"
    fi
    [ -n "$run" ] || die "ci log: no CI run found for ${sha:-$branch}"
    run_id="$(printf '%s' "$run" | jq -r '.id')"
    printf '%s' "$run" | jq -r '"run \(.id): status=\(.status)  \(.html_url // "")"'

    # Job list is a bare array; a job's terminal failure state is status=failure
    # (Forgejo folds conclusion into status).
    failed_jobs="$(_api GET "/actions/runs/${run_id}/jobs" \
      | jq -c '[.[]? | select(.status=="failure")]')"
    if [ "$(printf '%s' "$failed_jobs" | jq 'length')" -eq 0 ]; then
      echo "(no failed jobs for run ${run_id})"; exit 0
    fi
    printf '%s' "$failed_jobs" | jq -r '.[] | "\(.id)\t\(.name // "?")"' \
    | while IFS="$(printf '\t')" read -r jid jname; do
      echo "── job ${jid}: ${jname} ──"
      _api GET "/actions/jobs/${jid}/logs" || true
      echo
    done
    ;;

  *) die "unknown verb '${verb}' (ci: watch log)" ;;
esac
