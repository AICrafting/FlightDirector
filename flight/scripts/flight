#!/usr/bin/env bash
#
# flight dispatcher — the single entrypoint skills call.
#
#   flight <group> <verb> [--flag value …]
#
# Owns ALL config/secrets/axis logic, then execs the right backend adapter with
# the resolved coordinates + token in the environment. Adapters stay pure: they
# read LS_* and never parse config or know which axis they serve. See
# ../references/adapter-contract.md and docs/adr/0001-*.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
ADAPTERS_DIR="$SELF_DIR/adapters"

die() { echo "flight: $*" >&2; exit 1; }

[ $# -ge 2 ] || die "usage: flight <group> <verb> [args…]  (groups: issues labels pr ci auth config reconcile prompt-log)"
group="$1"; verb="$2"; shift 2

# Which config axis backs this group.
case "$group" in
  issues|labels) axis="issues" ;;
  pr|ci)         axis="code" ;;
  auth)          axis="code" ;;   # default; `auth check --axis issues` overrides it below
  config|reconcile|prompt-log) axis="" ;;   # handled below; no adapter needed
  *) die "unknown group '$group' (expected: issues labels pr ci auth config reconcile prompt-log)" ;;
esac

command -v jq >/dev/null 2>&1 || die "jq is required but not installed"

model_family() {
	model_id="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
	[ -n "$model_id" ] || die "labels model-family: --id must not be empty"

	# Providers may qualify an otherwise standard model id with a slash or
	# dotted routing prefix. Strip that transport detail before classifying.
	model_id="${model_id##*/}"
	case "$model_id" in
		*.claude-*) model_id="claude-${model_id##*.claude-}" ;;
		*.gpt-*) model_id="gpt-${model_id##*.gpt-}" ;;
	esac

	case "$model_id" in
		codex-auto-review|*-auto-review)
			die "model id '$1' is a tool or service, not a worked-by model; skipping label"
			;;
	esac

	if printf '%s' "$model_id" | grep -Eq '^gpt-[0-9]+([.][0-9]+)*-[[:alnum:]]+$'; then
		printf '%s\n' "${model_id##*-}"
		return
	fi
	if printf '%s' "$model_id" | grep -Eq '^gpt-[0-9]+([.][0-9]+)*$'; then
		printf '%s\n' "$model_id"
		return
	fi
	if printf '%s' "$model_id" | grep -Eq '^claude-[[:alnum:]]+-[0-9]+([.-][0-9]+)*$'; then
		model_id="${model_id#claude-}"
		printf '%s\n' "${model_id%%-*}"
		return
	fi

	family="$(printf '%s' "$model_id" | tr -cs '[:alnum:]' '-' | sed 's/^-//; s/-$//')"
	[ -n "$family" ] || die "model id '$1' has no usable family"
	echo "flight: warning — unrecognised model id '$1'; using family '$family'" >&2
	printf '%s\n' "$family"
}

# Model-family derivation is dispatcher-owned and intentionally needs no repo
# configuration or backend access.
if [ "$group" = "labels" ] && [ "$verb" = "model-family" ]; then
	[ "${1:-}" = "--id" ] && [ $# -eq 2 ] || die "usage: flight labels model-family --id <model-id>"
	model_family "$2"
	exit 0
fi

# Sugar for the standard provenance label. Adapters continue to receive only
# the backend-neutral `ensure --name/--color/--description` contract.
if [ "$group" = "labels" ] && [ "$verb" = "ensure" ] && [ "${1:-}" = "--model" ]; then
	[ $# -eq 2 ] || die "usage: flight labels ensure --model <model-id>"
	family="$(model_family "$2")"
	display="$(printf '%s' "$family" | awk '{ print toupper(substr($0, 1, 1)) substr($0, 2) }')"
	set -- --name "model/$family" --color "#d97757" --description "Issue was worked on using $display"
fi

# Resolve the MAIN repo root — parent of the common git dir — so this works the
# same from the main checkout and from a linked worktree (whose gitignored
# .flightdirector/secrets.json does not exist locally). Falls back to cwd outside a repo.
if cdir="$(git rev-parse --git-common-dir 2>/dev/null)"; then
  cdir="$(cd "$cdir" && pwd)" || die "cannot resolve git common dir: $cdir"   # absolutize (valid relative to cwd)
  repo_root="$(dirname "$cdir")"
else
  repo_root="$(pwd)"
fi
# Config home: `.flightdirector/` (family-level, shared by every Flight Director
# plugin). The pre-rename `.lightspeed/` folder is still honoured as a fallback so
# already-configured repos keep working; it is deprecated and setting-up-a-repo
# offers the move. Config and secrets resolve independently so a half-migrated
# repo (config moved, gitignored secrets not yet) still runs.
cfg_dir="$repo_root/.flightdirector"
if [ ! -f "$cfg_dir/config.json" ] && [ -f "$repo_root/.lightspeed/config.json" ]; then
  cfg_dir="$repo_root/.lightspeed"
  echo "flight: notice — reading legacy .lightspeed/config.json; the config folder is now .flightdirector/ (deprecated fallback: run setting-up-a-repo, or \`git mv .lightspeed .flightdirector\`)." >&2
fi
cfg="$cfg_dir/config.json"
sec="$cfg_dir/secrets.json"
[ -f "$sec" ] || { [ -f "$repo_root/.lightspeed/secrets.json" ] && sec="$repo_root/.lightspeed/secrets.json"; } || true
cfg_rel="${cfg#"$repo_root"/}"
sec_rel="${sec#"$repo_root"/}"

# `flight auth check [--secrets <file>] [--axis code|issues]` — verify a token
# BEFORE relying on it (identity, repo/project reach, per-capability read
# probes, expiry where the backend exposes it). Both flags are dispatcher-owned,
# like every other config/secrets concern:
#
#   --axis   which axis's coordinates and token to check (default `code`; use
#            `issues` for a split setup such as Jira issues + a git code host).
#   --secrets  read the token from a CANDIDATE file instead of the live one, so
#            a freshly minted token is verified before it replaces the real
#            `.flightdirector/secrets.json`. Rotation becomes: create token →
#            `auth check --secrets secrets-new.json` → move it into place.
#
# Token source precedence: --secrets > LS_SECRETS_FILE > the normal resolution
# (LS_TOKEN/FLIGHT_TOKEN env, then the repo's secrets file). An explicit
# candidate file deliberately beats an ambient env token — otherwise the check
# would silently verify a different token than the one being rotated in.
if [ "$group" = "auth" ]; then
  [ "$verb" = "check" ] || die "usage: flight auth check [--secrets <file>] [--axis code|issues]"
  secrets_override="${LS_SECRETS_FILE:-}"
  while [ $# -gt 0 ]; do case "$1" in
    --secrets) [ $# -ge 2 ] || die "auth check: --secrets needs a file path"; secrets_override="$2"; shift 2 ;;
    --axis)    [ $# -ge 2 ] || die "auth check: --axis needs a value"; axis="$2"; shift 2 ;;
    *) die "auth check: unknown arg '$1'" ;;
  esac; done
  case "$axis" in code|issues) ;; *) die "auth check: --axis must be code or issues (got '$axis')" ;; esac
  if [ -n "$secrets_override" ]; then
    [ -f "$secrets_override" ] || die "auth check: --secrets file '$secrets_override' not found"
    sec="$secrets_override"
    sec_rel="${sec#"$repo_root"/}"
    unset LS_TOKEN FLIGHT_TOKEN FORGEJO_TOKEN LS_EMAIL
  fi
fi

# Prompt logging is opt-in per repository. Hook processes must be silent when
# the switch or config is absent because bundled hooks run in every project.
if [ "$group" = "prompt-log" ]; then
	case "$verb" in prompt|stop|interrupt|subagent-stop|summary) ;; *) die "usage: flight prompt-log <prompt|stop|interrupt|subagent-stop|summary>" ;; esac
	# `summary` is the consumer side (work-ledger totals for a session); it needs
	# no harness and ignores the opt-in switch — it only reads what producers wrote.
	if [ "$verb" = "summary" ]; then
		export FLIGHT_REPO_ROOT="$repo_root"
		exec python3 "$SELF_DIR/prompt-logger/summary.py" "$@"
	fi
	harness="${LS_HARNESS:-}"
	if [ -z "$harness" ] && [ "${1:-}" = "--harness" ] && [ $# -eq 2 ]; then harness="$2"; fi
	case "$harness" in claude|codex) ;; *) die "prompt-log: set LS_HARNESS to claude or codex" ;; esac
	[ -f "$cfg" ] || exit 0
	jq -e '.code.promptLog.enabled == true' "$cfg" >/dev/null 2>&1 || exit 0
	producer="$SELF_DIR/prompt-logger/$harness.py"
	[ -f "$producer" ] || die "prompt-log: $harness producer is not installed"
	export FLIGHT_REPO_ROOT="$repo_root" FLIGHT_CONFIG_DIR="$cfg_dir"
	exec python3 "$producer" "$verb"
fi

# `flight reconcile --harness claude|codex` — cheap, idempotent compatibility
# preflight. It mutates only metadata, preserves unknown keys, and refuses to
# stamp an older installed plugin over a newer recorded version.
#
# The stamp is scoped per harness AND per plugin — `.flightdirector/` is the
# family-level folder shared by every Flight Director plugin, so a bare
# `harnesses.<h>.reconciledWith` would have every plugin stomping on one key and
# comparing its version against another plugin's. Schema 2 nests it as
# `harnesses.<h>.plugins.<name>.reconciledWith`; a legacy bare key is flight's by
# definition and is migrated into `plugins.flight` on the first run.
if [ "$group" = "reconcile" ]; then
  [ "$verb" = "--harness" ] || die "usage: flight reconcile --harness <claude|codex>"
  harness="${1:-}"
  case "$harness" in claude|codex) ;; *) die "unsupported harness '$harness' (expected claude or codex)" ;; esac
  [ -f "$cfg" ] || die "no .flightdirector/config.json at repo root ($repo_root)"
  manifest="$SELF_DIR/../.codex-plugin/plugin.json"
  [ -f "$manifest" ] || manifest="$SELF_DIR/../.claude-plugin/plugin.json"
  version="$(jq -r '.version // empty' "$manifest")"
  [ -n "$version" ] || die "cannot determine installed Flight version"
  plugin="$(jq -r '.name // empty' "$manifest")"
  [ -n "$plugin" ] || plugin="flight"
  # Legacy (schema 1) bare stamp — always flight's, whatever plugin is running.
  legacy="$(jq -r --arg h "$harness" '.harnesses[$h].reconciledWith // empty' "$cfg")"
  recorded="$(jq -r --arg h "$harness" --arg p "$plugin" '.harnesses[$h].plugins[$p].reconciledWith // empty' "$cfg")"
  if [ -z "$recorded" ] && [ "$plugin" = "flight" ]; then recorded="$legacy"; fi
  [ "$recorded" = "$version" ] && [ -z "$legacy" ] && exit 0
  if [ -n "$recorded" ] && [ "$(printf '%s\n%s\n' "$version" "$recorded" | sort -V | tail -n1)" = "$recorded" ] && [ "$recorded" != "$version" ]; then
    die "config was reconciled by newer $plugin $recorded; refusing downgrade to $version"
  fi
  tmp="$(mktemp "$cfg.tmp.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  jq --arg h "$harness" --arg p "$plugin" --arg v "$version" '
      .schemaVersion = ([(.schemaVersion // 0), 2] | max)
    | .harnesses = (.harnesses // {})
    | .harnesses[$h] = (.harnesses[$h] // {})
    | .harnesses[$h] |= (
          (if has("reconciledWith")
           then (.plugins.flight.reconciledWith = .reconciledWith) | del(.reconciledWith)
           else . end)
        | .plugins[$p].reconciledWith = $v
      )' \
    "$cfg" >"$tmp"
  jq -e . "$tmp" >/dev/null
  chmod --reference="$cfg" "$tmp" 2>/dev/null || true
  mv "$tmp" "$cfg"
  trap - EXIT
  printf 'flight: reconciled %s config with plugin %s %s\n' "$harness" "$plugin" "$version" >&2
  exit 0
fi

# `flight config <jq-filter>` — read the resolved config from anywhere (incl. a worktree).
if [ "$group" = "config" ]; then
  [ -f "$cfg" ] || die "no .flightdirector/config.json at repo root ($repo_root)"
  jq -r "$verb" "$cfg"
  exit 0
fi

[ -f "$cfg" ] || die "no .flightdirector/config.json at repo root ($repo_root)"

# Loud, every-run warning if the secrets file is tracked by git (it holds a token).
if [ -f "$sec" ] && git -C "$repo_root" ls-files --error-unmatch "$sec_rel" >/dev/null 2>&1; then
  echo "flight: WARNING — $sec_rel is tracked by git; it must be gitignored (it contains a token)." >&2
fi

# Resolve a config field for the axis, inheriting code → issues when absent.
cfg_get() { jq -r --arg a "$axis" --arg f "$1" '(.[$a][$f]) // (.code[$f]) // empty' "$cfg"; }

backend="$(cfg_get backend)"
[ -n "$backend" ] || die "no backend configured for axis '$axis' (set code.backend or ${axis}.backend in $cfg_rel)"

LS_API="$(cfg_get api)"
LS_OWNER="$(cfg_get owner)"
LS_REPO="$(cfg_get repo)"
# Generic passthroughs (backend-agnostic; empty unless the config sets them).
# `project` is a first-class coordinate for backends like Jira (the project key);
# `email` is needed by backends that use email:token HTTP Basic auth (Jira).
LS_PROJECT="$(cfg_get project)"
LS_TRUNK="$(jq -r '(.code.trunkBranch) // (.code.stages[0].name) // empty' "$cfg")"
LS_LABELS_JSON="$(jq -c '.labels // {}' "$cfg")"
# CI-watch hang-guard timeout (seconds). Precedence: env override → config
# code.ciWatchTimeout → adapter default (900). Empty stays empty so the adapter
# falls back to its own default.
LS_CI_WATCH_TIMEOUT="${LS_CI_WATCH_TIMEOUT:-$(jq -r '.code.ciWatchTimeout // empty' "$cfg")}"

# Token: env override first, then secrets file (axis, inheriting code → issues).
# Env override, backend-neutral: LS_TOKEN (adapter contract) or FLIGHT_TOKEN; FORGEJO_TOKEN is
# the legacy name from when Forgejo was the only backend and stays honoured.
LS_TOKEN="${LS_TOKEN:-${FLIGHT_TOKEN:-${FORGEJO_TOKEN:-}}}"
if [ -z "$LS_TOKEN" ] && [ -f "$sec" ]; then
  LS_TOKEN="$(jq -r --arg a "$axis" '(.[$a].token) // (.code.token) // empty' "$sec")"
fi
# Email (for email:token Basic auth): env override, then config, then secrets.
LS_EMAIL="${LS_EMAIL:-$(cfg_get email)}"
if [ -z "$LS_EMAIL" ] && [ -f "$sec" ]; then
  LS_EMAIL="$(jq -r --arg a "$axis" '(.[$a].email) // (.code.email) // empty' "$sec")"
fi

adapter="$ADAPTERS_DIR/$backend/$group"
[ -x "$adapter" ] || die "no '$group' adapter for backend '$backend' (expected $adapter)"

export LS_API LS_OWNER LS_REPO LS_PROJECT LS_EMAIL LS_TRUNK LS_TOKEN LS_LABELS_JSON LS_CI_WATCH_TIMEOUT LS_BACKEND="$backend"
exec "$adapter" "$verb" "$@"
