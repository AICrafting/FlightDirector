#!/usr/bin/env bash
#
# GitHub pull-request adapter — verbs: open get update merge list.
# See ../../../references/adapter-contract.md.
set -euo pipefail
ADAPTER_NAME="github/pr"
# shellcheck source-path=SCRIPTDIR source=_common.sh
source "$(cd "$(dirname "$0")" && pwd)/_common.sh"

verb="${1:-}"; shift || true

case "$verb" in
  list)
    state="open"; head=""; base=""; limit=30
    while [ $# -gt 0 ]; do case "$1" in
      --state)  state="$2"; shift 2 ;;
      --head)   head="$2"; shift 2 ;;
      --base)   base="$2"; shift 2 ;;
      --limit)  limit="$2"; shift 2 ;;
      *) die "pr list: unknown arg '$1'" ;;
    esac; done
    # GitHub has no `merged` state either: merged == closed with merged_at set.
    case "$state" in
      open)   api_state="open";   merged_only=0 ;;
      closed) api_state="closed"; merged_only=0 ;;
      merged) api_state="closed"; merged_only=1 ;;
      all)    api_state="all";    merged_only=0 ;;
      *) die "pr list: --state must be open|closed|merged|all" ;;
    esac
    # GitHub *does* filter by branch server-side — `head` wants owner:ref. Send it
    # (cheap, and keeps the fetch inside --limit), then re-check client-side so the
    # output is identical to the backends that can only filter locally.
    q="state=${api_state}&per_page=${limit}"
    [ -n "$head" ] && q="${q}&head=${LS_OWNER}:${head}"
    [ -n "$base" ] && q="${q}&base=${base}"
    _api GET "/pulls?${q}" \
      | jq -r --arg h "$head" --arg b "$base" --argjson m "$merged_only" '
          .[]
          | select($h == "" or .head.ref == $h)
          | select($b == "" or .base.ref == $b)
          | select($m == 0 or (.merged_at != null))
          | [ (.number|tostring),
              (if .merged_at != null then "merged" else .state end),
              .head.ref, .base.ref, .title ] | @tsv'
    ;;

  open)
    head=""; base=""; title=""; body=""; body_file=""
    while [ $# -gt 0 ]; do case "$1" in
      --head)      head="$2"; shift 2 ;;
      --base)      base="$2"; shift 2 ;;
      --title)     title="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      *) die "pr open: unknown arg '$1'" ;;
    esac; done
    [ -n "$base" ] || base="${LS_TRUNK:-}"
    [ -n "$head" ]  || die "pr open: --head required"
    [ -n "$base" ]  || die "pr open: --base required (and no code.trunkBranch configured)"
    [ -n "$title" ] || die "pr open: --title required"
    if [ -n "$body_file" ]; then
      [ -f "$body_file" ] || die "pr open: --body-file '$body_file' not found"
      payload="$(jq -n --arg h "$head" --arg b "$base" --arg t "$title" --rawfile body "$body_file" \
        '{head:$h, base:$b, title:$t, body:$body}')"
    else
      payload="$(jq -n --arg h "$head" --arg b "$base" --arg t "$title" --arg body "$body" \
        '{head:$h, base:$b, title:$t, body:$body}')"
    fi
    _api POST "/pulls" "$payload" | jq -r '[(.number|tostring), .html_url] | @tsv'
    ;;

  # Patch an open PR after the fact — only the fields passed are sent, so a
  # title fix does not clobber the body (and vice versa). Mirrors `issues update`.
  update)
    number=""; title=""; body=""; body_file=""; have_title=0; have_body=0
    while [ $# -gt 0 ]; do case "$1" in
      --number)    number="$2"; shift 2 ;;
      --title)     title="$2"; have_title=1; shift 2 ;;
      --body)      body="$2"; have_body=1; shift 2 ;;
      --body-file) body_file="$2"; have_body=1; shift 2 ;;
      *) die "pr update: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "pr update: --number required"
    patch='{}'
    [ "$have_title" = 1 ] && patch="$(printf '%s' "$patch" | jq --arg t "$title" '. + {title:$t}')"
    if [ "$have_body" = 1 ]; then
      if [ -n "$body_file" ]; then
        [ -f "$body_file" ] || die "pr update: --body-file '$body_file' not found"
        patch="$(printf '%s' "$patch" | jq --rawfile b "$body_file" '. + {body:$b}')"
      else
        patch="$(printf '%s' "$patch" | jq --arg b "$body" '. + {body:$b}')"
      fi
    fi
    [ "$patch" = '{}' ] && die "pr update: nothing to change (pass --title and/or --body)"
    _api PATCH "/pulls/${number}" "$patch" >/dev/null
    ;;

  get)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "pr get: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "pr get: --number required"
    _api GET "/pulls/${number}" \
      | jq -r '[(.number|tostring), .title, .state, .html_url] | @tsv'
    ;;

  merge)
    number=""; strategy="merge"
    while [ $# -gt 0 ]; do case "$1" in
      --number)   number="$2"; shift 2 ;;
      --strategy) strategy="$2"; shift 2 ;;
      *) die "pr merge: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "pr merge: --number required"
    case "$strategy" in
      merge|squash|rebase) ;;
      *) die "pr merge: --strategy must be merge|squash|rebase" ;;
    esac
    _api PUT "/pulls/${number}/merge" "$(jq -n --arg m "$strategy" '{merge_method:$m}')" >/dev/null
    ;;

  *) die "unknown verb '${verb}' (pr: open get update merge list)" ;;
esac
