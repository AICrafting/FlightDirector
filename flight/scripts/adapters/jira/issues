#!/usr/bin/env bash
#
# Jira Cloud issues adapter (REST v3) — verbs: list get comments create update
# comment set-status clear-status label-add label-remove assign unassign close
# reopen dep-add dep-remove dep-list dep-blocking.
#
# Jira specifics (see ../../../references/adapter-contract.md, "Jira backend"):
#   - The `--number` value is a Jira KEY (e.g. KAN-123), treated as an opaque id.
#   - set-status drives Jira LABELS (status/*), NOT workflow transitions.
#   - close/reopen are the one place transitions are unavoidable (labels can't close).
#   - bodies/comments round-trip through a minimal markdown⇄ADF shim (see _common.sh).
#   - Jira labels are single tokens: status label names in config must be space-free.
set -euo pipefail
ADAPTER_NAME="jira/issues"
# shellcheck source-path=SCRIPTDIR source=_common.sh
source "${0%/*}/_common.sh"

verb="${1:-}"; shift || true

# Base objects for --json (#253; ../_json.sh). One mapping per resource, so list,
# get and comments cannot drift apart. `number` is the native KEY; state comes from
# the status category exactly as `get` derives it (a missing category is an error,
# never a silent "open"); links are built from the site URL, which the API does not
# return; text fields go through the ADF shim.
# shellcheck disable=SC2016  # jq programs
ISSUE_JQ="$JSON_JQ$ADF_JQ"'
def text: if type == "string" then . elif . == null then "" else adf_to_text end;
def base_issue($site): {
  number: .key, title: (.fields.summary // ""),
  state: (.fields.status.statusCategory.key
    | if . == null then error("issues: no status category in the response")
      elif . == "done" then "closed" else "open" end),
  labels: (.fields.labels // []),
  author: (.fields.reporter.displayName // .fields.creator.displayName // null),
  created: (.fields.created | utc), updated: (.fields.updated | utc),
  comments: (.fields.comment.total // null), url: "\($site)/browse/\(.key)",
  body: (.fields.description | text)
};
def base_comment($site; $key): {
  id: (.id | tostring), author: (.author.displayName // .author.emailAddress // null),
  created: (.created | utc), updated: (.updated | utc),
  url: "\($site)/browse/\($key)?focusedCommentId=\(.id)", body: (.body | text)
};'

# jql_quote <s> — quote a JQL string literal (escape backslash and double-quote).
jql_quote() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }

case "$verb" in
  list)
    state="open"; limit="50"; labels=(); per_page=""; cursor=""
    while [ $# -gt 0 ]; do case "$1" in
      --state) state="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --label) labels+=("$2"); shift 2 ;;
      --per-page) per_page="$2"; shift 2 ;;
      --cursor) cursor="$2"; shift 2 ;;
      *) die "issues list: unknown arg '$1'" ;;
    esac; done
    jql="project = $(jql_quote "$LS_PROJECT")"
    case "$state" in
      open)   jql="$jql AND statusCategory != Done" ;;
      closed) jql="$jql AND statusCategory = Done" ;;
      all)    : ;;
      *) die "issues list: --state must be open|closed|all" ;;
    esac
    if [ ${#labels[@]} -gt 0 ]; then
      inlist=""
      for l in "${labels[@]}"; do inlist="${inlist:+$inlist, }$(jql_quote "$l")"; done
      jql="$jql AND labels IN ($inlist)"
    fi
    jql="$jql ORDER BY created DESC"
    # Enhanced-JQL search endpoint. (The legacy POST /rest/api/3/search was
    # decommissioned by Atlassian; /search/jql is its replacement.) It pages with
    # an opaque nextPageToken, which _jql_search follows up to --limit.
    # Cursor paging (#262): Jira pages forward by token only; see cursor_page_token.
    if [ -n "$per_page$cursor" ]; then
      json_mode || die "issues list: --per-page and --cursor need --json"
      per_page="$(per_page_arg "${per_page:-50}")" || exit 1
      _cursor_fetch() {
        _api POST "/rest/api/3/search/jql" "$(jq -n --arg j "$jql" --argjson m "$2" --arg t "$1" \
          --argjson f '["summary","labels","status","created","updated","reporter","creator"]' \
          '{jql:$j, maxResults:$m, fields:$f} + (if $t == "" then {} else {nextPageToken:$t} end)')"
      }
      meta="$(page_meta_init)"
      FLIGHT_PAGE_META="$meta" cursor_page_token _cursor_fetch '.issues[]?' '[(.fields.created | utc), (.key | split("-") | last | tonumber)]' \
          "$per_page" "$cursor" "jira $LS_API $jql" \
        | jq -c --arg site "$SITE" "$ISSUE_JQ"'base_issue($site) | .body = null' | emit_list "$meta"
      exit 0
    fi
    if json_mode; then
      meta="$(page_meta_init)"
      FLIGHT_PAGE_META="$meta" _jql_search "$jql" '["summary","labels","status","created","updated","reporter","creator"]' "$limit" \
        | jq -c --arg site "$SITE" "$ISSUE_JQ"'base_issue($site) | .body = null' | emit_list "$meta"
    else
      _jql_search "$jql" '["summary","labels"]' "$limit" \
        | jq -r '[.key, (.fields.summary // ""), ((.fields.labels // []) | join(","))] | @tsv'
    fi
    ;;

  get)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues get: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues get: --number required"
    # `status` joins the field list for the state column. Jira has no open/closed
    # flag, so the status CATEGORY decides — the same rule `list` (statusCategory
    # != Done) and `close`/`reopen` (transition by category key) already use, so a
    # per-project workflow with custom status names maps correctly without config.
    # A missing category is an error, not an "open": Jira is the only backend that
    # DERIVES state rather than reading it, and defaulting to open is the one
    # direction that would let a done issue pass a caller's open/closed check.
    if json_mode; then
      _api GET "/rest/api/3/issue/${number}?fields=summary,description,status,labels,created,updated,reporter,creator,comment" \
        | jq -c --arg site "$SITE" "$ISSUE_JQ"'base_issue($site)'
      exit 0
    fi
    _api GET "/rest/api/3/issue/${number}?fields=summary,description,status" \
      | jq -r "$ADF_JQ"'
          ([.key, (.fields.summary // ""),
            (.fields.status.statusCategory.key
             | if . == null then error("issues get: no status category in the response")
               elif . == "done" then "closed" else "open" end)]
           | @tsv), "",
          ((.fields.description // "") | if type=="string" then . else adf_to_text end)'
    ;;

  comments)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues comments: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues comments: --number required"
    # One block per comment, oldest-first: `author⇥created` header, the body as
    # plain text, then a blank separator. Empty output (exit 0) means no comments.
    # Paged to exhaustion: this endpoint returns 50 comments per request and the
    # thread renders oldest-first, so an unpaged fetch drops the NEWEST comments —
    # precisely the ones "the later comment wins" depends on.
    if json_mode; then
      _offset_get "/rest/api/3/issue/${number}/comment" "" comments "" \
        | jq -cs --arg site "$SITE" --arg key "$number" "$ISSUE_JQ"'map(base_comment($site; $key))'
      exit 0
    fi
    _offset_get "/rest/api/3/issue/${number}/comment" "" comments "" \
      | jq -r "$ADF_JQ"'
          ([(.author.displayName // .author.emailAddress // "?"), (.created // "")] | @tsv),
          ((.body // "") | if type=="string" then . else adf_to_text end),
          ""'
    ;;

  create)
    title=""; body=""; body_file=""; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --title)     title="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      --label)     labels+=("$2"); shift 2 ;;
      *) die "issues create: unknown arg '$1'" ;;
    esac; done
    [ -n "$title" ] || die "issues create: --title required"
    fields="$(jq -n --arg p "$LS_PROJECT" --arg t "$title" \
      '{project:{key:$p}, issuetype:{name:"Task"}, summary:$t}')"
    if [ -n "$body_file" ]; then
      [ -f "$body_file" ] || die "issues create: --body-file '$body_file' not found"
      adf="$(md_file_to_adf_json "$body_file")"
      fields="$(printf '%s' "$fields" | jq --argjson d "$adf" '. + {description:$d}')"
    elif [ -n "$body" ]; then
      adf="$(md_to_adf_json "$body")"
      fields="$(printf '%s' "$fields" | jq --argjson d "$adf" '. + {description:$d}')"
    fi
    if [ ${#labels[@]} -gt 0 ]; then
      names_json="$(printf '%s\n' "${labels[@]}" | jq -R . | jq -s .)"
      fields="$(printf '%s' "$fields" | jq --argjson l "$names_json" '. + {labels:$l}')"
    fi
    _api POST "/rest/api/3/issue" "$(jq -n --argjson f "$fields" '{fields:$f}')" | jq -r '.key'
    ;;

  update)
    number=""; title=""; body=""; body_file=""; have_title=0; have_body=0
    while [ $# -gt 0 ]; do case "$1" in
      --number)    number="$2"; shift 2 ;;
      --title)     title="$2"; have_title=1; shift 2 ;;
      --body)      body="$2"; have_body=1; shift 2 ;;
      --body-file) body_file="$2"; have_body=1; shift 2 ;;
      *) die "issues update: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues update: --number required"
    fields='{}'
    [ "$have_title" = 1 ] && fields="$(printf '%s' "$fields" | jq --arg t "$title" '. + {summary:$t}')"
    if [ "$have_body" = 1 ]; then
      if [ -n "$body_file" ]; then
        [ -f "$body_file" ] || die "issues update: --body-file '$body_file' not found"
        adf="$(md_file_to_adf_json "$body_file")"
      else
        adf="$(md_to_adf_json "$body")"
      fi
      fields="$(printf '%s' "$fields" | jq --argjson d "$adf" '. + {description:$d}')"
    fi
    [ "$fields" = '{}' ] && die "issues update: nothing to change (pass --title and/or --body)"
    _api PUT "/rest/api/3/issue/${number}" "$(jq -n --argjson f "$fields" '{fields:$f}')" >/dev/null
    ;;

  attach)
    # Also the answer to --check (FJ-311).
    fail unsupported "issues attach: not supported by the jira adapter (out of scope for the issues-axis backend)"
    ;;

  comment)
    number=""; body=""; body_file=""
    while [ $# -gt 0 ]; do case "$1" in
      --number)    number="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      *) die "issues comment: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues comment: --number required"
    if [ -n "$body_file" ]; then
      [ -f "$body_file" ] || die "issues comment: --body-file '$body_file' not found"
      adf="$(md_file_to_adf_json "$body_file")"
    else
      adf="$(md_to_adf_json "$body")"
    fi
    if json_mode; then
      _api POST "/rest/api/3/issue/${number}/comment" "$(jq -n --argjson b "$adf" '{body:$b}')" \
        | jq -c --arg site "$SITE" --arg key "$number" "$ISSUE_JQ"'base_comment($site; $key)'
    else
      _api POST "/rest/api/3/issue/${number}/comment" "$(jq -n --argjson b "$adf" '{body:$b}')" >/dev/null
    fi
    ;;

  set-status)
    number=""; role=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --status) role="$2"; shift 2 ;;
      *) die "issues set-status: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues set-status: --number required"
    [ -n "$role" ]   || die "issues set-status: --status required"
    labels_json="${LS_LABELS_JSON:-}"; [ -n "$labels_json" ] || labels_json='{}'
    target_name="$(printf '%s' "$labels_json" | jq -r --arg r "$role" '.status[$r] // empty')"
    [ -n "$target_name" ] || die "set-status: role '$role' not found in labels.status config"
    case "$target_name" in *" "*) die "set-status: Jira labels cannot contain spaces — '$target_name' is invalid (use space-free status names in config)";; esac
    # Atomic single-status: remove every OTHER managed status label present, add target.
    current="$(_api GET "/rest/api/3/issue/${number}?fields=labels" | jq -c '.fields.labels // []')"
    others="$(printf '%s' "$labels_json" | jq -c --arg t "$target_name" --argjson cur "$current" \
      '[(.status // {} | .[]) | select(type == "string") | select(. != $t) | select(. as $n | $cur | index($n) != null)]')"
    ops="$(jq -n --arg t "$target_name" --argjson rm "$others" \
      '[$rm[] | {remove:.}] + [{add:$t}]')"
    _api PUT "/rest/api/3/issue/${number}" "$(jq -n --argjson o "$ops" '{update:{labels:$o}}')" >/dev/null
    ;;

  clear-status)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues clear-status: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues clear-status: --number required"
    labels_json="${LS_LABELS_JSON:-}"; [ -n "$labels_json" ] || labels_json='{}'
    current="$(_api GET "/rest/api/3/issue/${number}?fields=labels" | jq -c '.fields.labels // []')"
    ops="$(printf '%s' "$labels_json" | jq -c --argjson cur "$current" \
      '[(.status // {} | .[]) | select(. as $n | $cur | index($n) != null) | {remove:.}]')"
    [ "$ops" = "[]" ] && exit 0
    _api PUT "/rest/api/3/issue/${number}" "$(jq -n --argjson o "$ops" '{update:{labels:$o}}')" >/dev/null
    ;;

  label-add)
    number=""; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --label)  labels+=("$2"); shift 2 ;;
      *) die "issues label-add: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues label-add: --number required"
    [ ${#labels[@]} -gt 0 ] || die "issues label-add: at least one --label required"
    for n in "${labels[@]}"; do
      case "$n" in *" "*) die "issues label-add: Jira labels cannot contain spaces — '$n' is invalid";; esac
    done
    names_json="$(printf '%s\n' "${labels[@]}" | jq -R . | jq -s .)"
    ops="$(jq -n --argjson l "$names_json" '[$l[] | {add:.}]')"
    _api PUT "/rest/api/3/issue/${number}" "$(jq -n --argjson o "$ops" '{update:{labels:$o}}')" >/dev/null
    ;;

  # Mirror of label-add. Jira labels are free text with no repo-level registry,
  # so there is nothing to validate beyond the space rule; only labels the issue
  # actually carries are removed, which makes this idempotent.
  label-remove)
    number=""; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --label)  labels+=("$2"); shift 2 ;;
      *) die "issues label-remove: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues label-remove: --number required"
    [ ${#labels[@]} -gt 0 ] || die "issues label-remove: at least one --label required"
    for n in "${labels[@]}"; do
      case "$n" in *" "*) die "issues label-remove: Jira labels cannot contain spaces — '$n' is invalid";; esac
    done
    names_json="$(printf '%s\n' "${labels[@]}" | jq -R . | jq -s .)"
    current="$(_api GET "/rest/api/3/issue/${number}?fields=labels" | jq -c '.fields.labels // []')"
    ops="$(jq -n --argjson l "$names_json" --argjson cur "$current" \
      '[$l[] | select(. as $n | $cur | index($n) != null) | {remove:.}]')"
    [ "$ops" = "[]" ] && exit 0
    _api PUT "/rest/api/3/issue/${number}" "$(jq -n --argjson o "$ops" '{update:{labels:$o}}')" >/dev/null
    ;;

  # Assign the issue to one user. Jira Cloud wants an accountId, so --user
  # (email or display name) is resolved via user search; Jira holds a single
  # assignee, so --user is NOT repeatable here. `unassign` clears it.
  assign)
    number=""; user=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --user)   [ -z "$user" ] || die "issues assign: Jira supports a single assignee — pass --user once"
                user="$2"; shift 2 ;;
      *) die "issues assign: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues assign: --number required"
    [ -n "$user" ]   || die "issues assign: --user required"
    aid="$(_api GET "/rest/api/3/user/search?query=$(urlenc "$user")" \
      | jq -r '.[0].accountId // empty')"
    [ -n "$aid" ] || die "issues assign: no Jira user matches '${user}'"
    _api PUT "/rest/api/3/issue/${number}/assignee" "$(jq -n --arg id "$aid" '{accountId:$id}')" >/dev/null
    ;;

  unassign)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues unassign: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues unassign: --number required"
    _api PUT "/rest/api/3/issue/${number}/assignee" '{"accountId":null}' >/dev/null
    ;;

  close)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues close: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues close: --number required"
    # Labels can't close a Jira issue — drive a workflow transition into the Done category.
    tid="$(_api GET "/rest/api/3/issue/${number}/transitions" \
      | jq -r '[.transitions[]? | select(.to.statusCategory.key == "done") | .id] | first // empty')"
    [ -n "$tid" ] || die "issues close: no transition into a Done-category status is available for ${number}"
    _api POST "/rest/api/3/issue/${number}/transitions" "$(jq -n --arg id "$tid" '{transition:{id:$id}}')" >/dev/null
    ;;

  reopen)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues reopen: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues reopen: --number required"
    # Inverse of close: transition back to a To-Do (new) or In-Progress (indeterminate) status.
    tid="$(_api GET "/rest/api/3/issue/${number}/transitions" \
      | jq -r '(.transitions // []) as $t
               | ([$t[] | select(.to.statusCategory.key == "new")         | .id] | first)
              // ([$t[] | select(.to.statusCategory.key == "indeterminate") | .id] | first)
              // empty')"
    [ -n "$tid" ] || die "issues reopen: no transition into a To-Do/In-Progress status is available for ${number}"
    _api POST "/rest/api/3/issue/${number}/transitions" "$(jq -n --arg id "$tid" '{transition:{id:$id}}')" >/dev/null
    ;;

  dep-add|dep-remove|dep-list|dep-blocking)
    # Issue dependencies (FJ-271) as issue links. The link type is found by its inward text
    # ("is blocked by"), else by the name "Blocks": an admin can rename either. Seen from an
    # issue's `issuelinks`, an entry holding `inwardIssue` reads "<this issue> is blocked by
    # <inwardIssue>", and one holding `outwardIssue` reads "<this issue> blocks <outwardIssue>".
    # Creating "N is blocked by M" therefore posts M as the inward issue (pinned on the live
    # rig: test-rig/jira/smoke.sh).
    number=""; by=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --by) by="$2"; shift 2 ;;
      *) die "issues $verb: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues $verb: --number required"
    case "$verb" in dep-add|dep-remove) [ -n "$by" ] || die "issues $verb: --by required" ;; esac
    ltype="$(_api GET "/rest/api/3/issueLinkType" | jq -c '
      ([.issueLinkTypes[]? | select((.inward // "" | ascii_downcase) == "is blocked by")]
       + [.issueLinkTypes[]? | select(.name == "Blocks")]) | first // empty')"
    [ -n "$ltype" ] || fail unsupported "this Jira site has no \"is blocked by\" issue link type"
    links="$(_api GET "/rest/api/3/issue/${number}?fields=issuelinks" | jq -c --argjson t "$ltype" --arg p "$LS_PROJECT" '
      [.fields.issuelinks[]? | select(.type.id == $t.id)
       | if .inwardIssue then {id: .id, side: "blocked_by", issue: .inwardIssue} else {id: .id, side: "blocks", issue: .outwardIssue} end
       | select(.issue.key | startswith($p + "-"))
       | {side, link: .id, number: .issue.key, title: (.issue.fields.summary // ""),
          state: (if .issue.fields.status.statusCategory.key == "done" then "closed" else "open" end)}]')"
    case "$verb" in
      dep-list)     jq -c '[.[] | select(.side == "blocked_by") | {number, title, state}]' <<<"$links" | dep_emit ;;
      dep-blocking) jq -c '[.[] | select(.side == "blocks") | {number, title, state}]' <<<"$links" | dep_emit ;;
      dep-add)
        [ "$(jq --arg b "$by" '[.[] | select(.side == "blocked_by" and .number == $b)] | length' <<<"$links")" = 0 ] || exit 0
        _api POST "/rest/api/3/issueLink" \
          "$(jq -cn --argjson t "$ltype" --arg b "$by" --arg n "$number" '{type: {id: $t.id}, inwardIssue: {key: $b}, outwardIssue: {key: $n}}')" >/dev/null
        ;;
      dep-remove)
        link="$(jq -r --arg b "$by" '[.[] | select(.side == "blocked_by" and .number == $b)] | first | .link // empty' <<<"$links")"
        [ -n "$link" ] || exit 0
        _api DELETE "/rest/api/3/issueLink/${link}" >/dev/null
        ;;
    esac
    ;;

  *) die "unknown verb '${verb}' (issues: list get comments create update comment set-status clear-status label-add label-remove assign unassign close reopen dep-add dep-remove dep-list dep-blocking)" ;;
esac
