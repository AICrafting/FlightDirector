#!/usr/bin/env bash
#
# Jira Cloud issues adapter (REST v3) — verbs: list get comments create update
# comment set-status clear-status label-add label-remove assign unassign close
# reopen.
#
# Jira specifics (see ../../../references/adapter-contract.md, "Jira backend"):
#   - The `--number` value is a Jira KEY (e.g. KAN-123), treated as an opaque id.
#   - set-status drives Jira LABELS (status/*), NOT workflow transitions.
#   - close/reopen are the one place transitions are unavoidable (labels can't close).
#   - bodies/comments round-trip through a minimal markdown⇄ADF shim (see _common.sh).
#   - Jira labels are single tokens: status label names in config must be space-free.
set -euo pipefail
ADAPTER_NAME="jira/issues"
# shellcheck source-path=SCRIPTDIR source=_common.sh
source "$(cd "$(dirname "$0")" && pwd)/_common.sh"

verb="${1:-}"; shift || true

# jql_quote <s> — quote a JQL string literal (escape backslash and double-quote).
jql_quote() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }

case "$verb" in
  list)
    state="open"; limit="50"; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --state) state="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --label) labels+=("$2"); shift 2 ;;
      *) die "issues list: unknown arg '$1'" ;;
    esac; done
    jql="project = $(jql_quote "$LS_PROJECT")"
    case "$state" in
      open)   jql="$jql AND statusCategory != Done" ;;
      closed) jql="$jql AND statusCategory = Done" ;;
      all)    : ;;
      *) die "issues list: --state must be open|closed|all" ;;
    esac
    if [ ${#labels[@]} -gt 0 ]; then
      inlist=""
      for l in "${labels[@]}"; do inlist="${inlist:+$inlist, }$(jql_quote "$l")"; done
      jql="$jql AND labels IN ($inlist)"
    fi
    jql="$jql ORDER BY created DESC"
    payload="$(jq -n --arg j "$jql" --argjson m "$limit" '{jql:$j, maxResults:$m, fields:["summary","labels"]}')"
    # Enhanced-JQL search endpoint. (The legacy POST /rest/api/3/search was
    # decommissioned by Atlassian — /search/jql is its replacement.)
    _api POST "/rest/api/3/search/jql" "$payload" \
      | jq -r '.issues[]? | [.key, (.fields.summary // ""), ((.fields.labels // []) | join(","))] | @tsv'
    ;;

  get)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues get: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues get: --number required"
    _api GET "/rest/api/3/issue/${number}?fields=summary,description" \
      | jq -r "$ADF_JQ"'
          ([.key, (.fields.summary // "")] | @tsv), "",
          ((.fields.description // "") | if type=="string" then . else adf_to_text end)'
    ;;

  comments)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues comments: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues comments: --number required"
    # One block per comment, oldest-first: `author⇥created` header, the body as
    # plain text, then a blank separator. Empty output (exit 0) means no comments.
    _api GET "/rest/api/3/issue/${number}/comment" \
      | jq -r "$ADF_JQ"'
          .comments[]? |
          ([(.author.displayName // .author.emailAddress // "?"), (.created // "")] | @tsv),
          ((.body // "") | if type=="string" then . else adf_to_text end),
          ""'
    ;;

  create)
    title=""; body=""; body_file=""; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --title)     title="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      --label)     labels+=("$2"); shift 2 ;;
      *) die "issues create: unknown arg '$1'" ;;
    esac; done
    [ -n "$title" ] || die "issues create: --title required"
    fields="$(jq -n --arg p "$LS_PROJECT" --arg t "$title" \
      '{project:{key:$p}, issuetype:{name:"Task"}, summary:$t}')"
    if [ -n "$body_file" ]; then
      [ -f "$body_file" ] || die "issues create: --body-file '$body_file' not found"
      adf="$(md_file_to_adf_json "$body_file")"
      fields="$(printf '%s' "$fields" | jq --argjson d "$adf" '. + {description:$d}')"
    elif [ -n "$body" ]; then
      adf="$(md_to_adf_json "$body")"
      fields="$(printf '%s' "$fields" | jq --argjson d "$adf" '. + {description:$d}')"
    fi
    if [ ${#labels[@]} -gt 0 ]; then
      names_json="$(printf '%s\n' "${labels[@]}" | jq -R . | jq -s .)"
      fields="$(printf '%s' "$fields" | jq --argjson l "$names_json" '. + {labels:$l}')"
    fi
    _api POST "/rest/api/3/issue" "$(jq -n --argjson f "$fields" '{fields:$f}')" | jq -r '.key'
    ;;

  update)
    number=""; title=""; body=""; body_file=""; have_title=0; have_body=0
    while [ $# -gt 0 ]; do case "$1" in
      --number)    number="$2"; shift 2 ;;
      --title)     title="$2"; have_title=1; shift 2 ;;
      --body)      body="$2"; have_body=1; shift 2 ;;
      --body-file) body_file="$2"; have_body=1; shift 2 ;;
      *) die "issues update: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues update: --number required"
    fields='{}'
    [ "$have_title" = 1 ] && fields="$(printf '%s' "$fields" | jq --arg t "$title" '. + {summary:$t}')"
    if [ "$have_body" = 1 ]; then
      if [ -n "$body_file" ]; then
        [ -f "$body_file" ] || die "issues update: --body-file '$body_file' not found"
        adf="$(md_file_to_adf_json "$body_file")"
      else
        adf="$(md_to_adf_json "$body")"
      fi
      fields="$(printf '%s' "$fields" | jq --argjson d "$adf" '. + {description:$d}')"
    fi
    [ "$fields" = '{}' ] && die "issues update: nothing to change (pass --title and/or --body)"
    _api PUT "/rest/api/3/issue/${number}" "$(jq -n --argjson f "$fields" '{fields:$f}')" >/dev/null
    ;;

  attach)
    die "issues attach: not supported by the jira adapter (out of scope for the issues-axis backend)"
    ;;

  comment)
    number=""; body=""; body_file=""
    while [ $# -gt 0 ]; do case "$1" in
      --number)    number="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      *) die "issues comment: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues comment: --number required"
    if [ -n "$body_file" ]; then
      [ -f "$body_file" ] || die "issues comment: --body-file '$body_file' not found"
      adf="$(md_file_to_adf_json "$body_file")"
    else
      adf="$(md_to_adf_json "$body")"
    fi
    _api POST "/rest/api/3/issue/${number}/comment" "$(jq -n --argjson b "$adf" '{body:$b}')" >/dev/null
    ;;

  set-status)
    number=""; role=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --status) role="$2"; shift 2 ;;
      *) die "issues set-status: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues set-status: --number required"
    [ -n "$role" ]   || die "issues set-status: --status required"
    labels_json="${LS_LABELS_JSON:-}"; [ -n "$labels_json" ] || labels_json='{}'
    target_name="$(printf '%s' "$labels_json" | jq -r --arg r "$role" '.status[$r] // empty')"
    [ -n "$target_name" ] || die "set-status: role '$role' not found in labels.status config"
    case "$target_name" in *" "*) die "set-status: Jira labels cannot contain spaces — '$target_name' is invalid (use space-free status names in config)";; esac
    # Atomic single-status: remove every OTHER managed status label present, add target.
    current="$(_api GET "/rest/api/3/issue/${number}?fields=labels" | jq -c '.fields.labels // []')"
    others="$(printf '%s' "$labels_json" | jq -c --arg t "$target_name" --argjson cur "$current" \
      '[(.status // {} | .[]) | select(. != $t) | select(. as $n | $cur | index($n) != null)]')"
    ops="$(jq -n --arg t "$target_name" --argjson rm "$others" \
      '[$rm[] | {remove:.}] + [{add:$t}]')"
    _api PUT "/rest/api/3/issue/${number}" "$(jq -n --argjson o "$ops" '{update:{labels:$o}}')" >/dev/null
    ;;

  clear-status)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues clear-status: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues clear-status: --number required"
    labels_json="${LS_LABELS_JSON:-}"; [ -n "$labels_json" ] || labels_json='{}'
    current="$(_api GET "/rest/api/3/issue/${number}?fields=labels" | jq -c '.fields.labels // []')"
    ops="$(printf '%s' "$labels_json" | jq -c --argjson cur "$current" \
      '[(.status // {} | .[]) | select(. as $n | $cur | index($n) != null) | {remove:.}]')"
    [ "$ops" = "[]" ] && exit 0
    _api PUT "/rest/api/3/issue/${number}" "$(jq -n --argjson o "$ops" '{update:{labels:$o}}')" >/dev/null
    ;;

  label-add)
    number=""; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --label)  labels+=("$2"); shift 2 ;;
      *) die "issues label-add: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues label-add: --number required"
    [ ${#labels[@]} -gt 0 ] || die "issues label-add: at least one --label required"
    for n in "${labels[@]}"; do
      case "$n" in *" "*) die "issues label-add: Jira labels cannot contain spaces — '$n' is invalid";; esac
    done
    names_json="$(printf '%s\n' "${labels[@]}" | jq -R . | jq -s .)"
    ops="$(jq -n --argjson l "$names_json" '[$l[] | {add:.}]')"
    _api PUT "/rest/api/3/issue/${number}" "$(jq -n --argjson o "$ops" '{update:{labels:$o}}')" >/dev/null
    ;;

  # Mirror of label-add. Jira labels are free text with no repo-level registry,
  # so there is nothing to validate beyond the space rule; only labels the issue
  # actually carries are removed, which makes this idempotent.
  label-remove)
    number=""; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --label)  labels+=("$2"); shift 2 ;;
      *) die "issues label-remove: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues label-remove: --number required"
    [ ${#labels[@]} -gt 0 ] || die "issues label-remove: at least one --label required"
    for n in "${labels[@]}"; do
      case "$n" in *" "*) die "issues label-remove: Jira labels cannot contain spaces — '$n' is invalid";; esac
    done
    names_json="$(printf '%s\n' "${labels[@]}" | jq -R . | jq -s .)"
    current="$(_api GET "/rest/api/3/issue/${number}?fields=labels" | jq -c '.fields.labels // []')"
    ops="$(jq -n --argjson l "$names_json" --argjson cur "$current" \
      '[$l[] | select(. as $n | $cur | index($n) != null) | {remove:.}]')"
    [ "$ops" = "[]" ] && exit 0
    _api PUT "/rest/api/3/issue/${number}" "$(jq -n --argjson o "$ops" '{update:{labels:$o}}')" >/dev/null
    ;;

  # Assign the issue to one user. Jira Cloud wants an accountId, so --user
  # (email or display name) is resolved via user search; Jira holds a single
  # assignee, so --user is NOT repeatable here. `unassign` clears it.
  assign)
    number=""; user=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --user)   [ -z "$user" ] || die "issues assign: Jira supports a single assignee — pass --user once"
                user="$2"; shift 2 ;;
      *) die "issues assign: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues assign: --number required"
    [ -n "$user" ]   || die "issues assign: --user required"
    aid="$(_api GET "/rest/api/3/user/search?query=$(jq -rn --arg q "$user" '$q|@uri')" \
      | jq -r '.[0].accountId // empty')"
    [ -n "$aid" ] || die "issues assign: no Jira user matches '${user}'"
    _api PUT "/rest/api/3/issue/${number}/assignee" "$(jq -n --arg id "$aid" '{accountId:$id}')" >/dev/null
    ;;

  unassign)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues unassign: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues unassign: --number required"
    _api PUT "/rest/api/3/issue/${number}/assignee" '{"accountId":null}' >/dev/null
    ;;

  close)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues close: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues close: --number required"
    # Labels can't close a Jira issue — drive a workflow transition into the Done category.
    tid="$(_api GET "/rest/api/3/issue/${number}/transitions" \
      | jq -r '[.transitions[]? | select(.to.statusCategory.key == "done") | .id] | first // empty')"
    [ -n "$tid" ] || die "issues close: no transition into a Done-category status is available for ${number}"
    _api POST "/rest/api/3/issue/${number}/transitions" "$(jq -n --arg id "$tid" '{transition:{id:$id}}')" >/dev/null
    ;;

  reopen)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues reopen: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues reopen: --number required"
    # Inverse of close: transition back to a To-Do (new) or In-Progress (indeterminate) status.
    tid="$(_api GET "/rest/api/3/issue/${number}/transitions" \
      | jq -r '(.transitions // []) as $t
               | ([$t[] | select(.to.statusCategory.key == "new")         | .id] | first)
              // ([$t[] | select(.to.statusCategory.key == "indeterminate") | .id] | first)
              // empty')"
    [ -n "$tid" ] || die "issues reopen: no transition into a To-Do/In-Progress status is available for ${number}"
    _api POST "/rest/api/3/issue/${number}/transitions" "$(jq -n --arg id "$tid" '{transition:{id:$id}}')" >/dev/null
    ;;

  *) die "unknown verb '${verb}' (issues: list get comments create update comment set-status clear-status label-add label-remove assign unassign close reopen)" ;;
esac
