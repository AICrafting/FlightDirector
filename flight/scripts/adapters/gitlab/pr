#!/usr/bin/env bash
#
# GitLab merge-request adapter — verbs: open get update merge list. (The contract's "pr" == MR here.)
# See ../../../references/adapter-contract.md.
set -euo pipefail
ADAPTER_NAME="gitlab/pr"
# shellcheck source-path=SCRIPTDIR source=_common.sh
source "$(cd "$(dirname "$0")" && pwd)/_common.sh"

verb="${1:-}"; shift || true

case "$verb" in
  list)
    state="open"; head=""; base=""; limit=30
    while [ $# -gt 0 ]; do case "$1" in
      --state)  state="$2"; shift 2 ;;
      --head)   head="$2"; shift 2 ;;
      --base)   base="$2"; shift 2 ;;
      --limit)  limit="$2"; shift 2 ;;
      *) die "pr list: unknown arg '$1'" ;;
    esac; done
    # GitLab is the one backend with a first-class `merged` state, and it filters by
    # source/target branch server-side. `open` is spelled `opened`.
    case "$state" in
      open)   api_state="opened" ;;
      closed) api_state="closed" ;;
      merged) api_state="merged" ;;
      all)    api_state="all" ;;
      *) die "pr list: --state must be open|closed|merged|all" ;;
    esac
    q="state=${api_state}&per_page=${limit}"
    [ -n "$head" ] && q="${q}&source_branch=${head}"
    [ -n "$base" ] && q="${q}&target_branch=${base}"
    _api GET "/merge_requests?${q}" \
      | jq -r --arg h "$head" --arg b "$base" '
          .[]
          | select($h == "" or .source_branch == $h)
          | select($b == "" or .target_branch == $b)
          | [ (.iid|tostring), .state, .source_branch, .target_branch, .title ] | @tsv'
    ;;

  open)
    head=""; base=""; title=""; body=""; body_file=""
    while [ $# -gt 0 ]; do case "$1" in
      --head)      head="$2"; shift 2 ;;
      --base)      base="$2"; shift 2 ;;
      --title)     title="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      *) die "pr open: unknown arg '$1'" ;;
    esac; done
    [ -n "$base" ] || base="${LS_TRUNK:-}"
    [ -n "$head" ]  || die "pr open: --head required"
    [ -n "$base" ]  || die "pr open: --base required (and no code.trunkBranch configured)"
    [ -n "$title" ] || die "pr open: --title required"
    # GitLab: source_branch → target_branch, description holds the body.
    if [ -n "$body_file" ]; then
      [ -f "$body_file" ] || die "pr open: --body-file '$body_file' not found"
      payload="$(jq -n --arg h "$head" --arg b "$base" --arg t "$title" --rawfile body "$body_file" \
        '{source_branch:$h, target_branch:$b, title:$t, description:$body}')"
    else
      payload="$(jq -n --arg h "$head" --arg b "$base" --arg t "$title" --arg body "$body" \
        '{source_branch:$h, target_branch:$b, title:$t, description:$body}')"
    fi
    _api POST "/merge_requests" "$payload" | jq -r '[(.iid|tostring), .web_url] | @tsv'
    ;;

  # Patch an open PR after the fact — only the fields passed are sent, so a
  # title fix does not clobber the body (and vice versa). Mirrors `issues update`.
  update)
    number=""; title=""; body=""; body_file=""; have_title=0; have_body=0
    while [ $# -gt 0 ]; do case "$1" in
      --number)    number="$2"; shift 2 ;;
      --title)     title="$2"; have_title=1; shift 2 ;;
      --body)      body="$2"; have_body=1; shift 2 ;;
      --body-file) body_file="$2"; have_body=1; shift 2 ;;
      *) die "pr update: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "pr update: --number required"
    patch='{}'
    [ "$have_title" = 1 ] && patch="$(printf '%s' "$patch" | jq --arg t "$title" '. + {title:$t}')"
    if [ "$have_body" = 1 ]; then
      if [ -n "$body_file" ]; then
        [ -f "$body_file" ] || die "pr update: --body-file '$body_file' not found"
        patch="$(printf '%s' "$patch" | jq --rawfile b "$body_file" '. + {description:$b}')"
      else
        patch="$(printf '%s' "$patch" | jq --arg b "$body" '. + {description:$b}')"
      fi
    fi
    [ "$patch" = '{}' ] && die "pr update: nothing to change (pass --title and/or --body)"
    _api PUT "/merge_requests/${number}" "$patch" >/dev/null
    ;;

  get)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "pr get: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "pr get: --number required"
    _api GET "/merge_requests/${number}" \
      | jq -r '[(.iid|tostring), .title, .state, .web_url] | @tsv'
    ;;

  merge)
    number=""; strategy="merge"
    while [ $# -gt 0 ]; do case "$1" in
      --number)   number="$2"; shift 2 ;;
      --strategy) strategy="$2"; shift 2 ;;
      *) die "pr merge: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "pr merge: --number required"
    # GitLab's merge endpoint takes a `squash` boolean; the merge/rebase distinction
    # otherwise follows the project's merge method (a rebase/fast-forward merge needs
    # the project configured for it). See adapter-contract.md → GitLab specifics.
    case "$strategy" in
      squash)        payload='{"squash":true}' ;;
      merge|rebase)  payload='{"squash":false}' ;;
      *) die "pr merge: --strategy must be merge|squash|rebase" ;;
    esac
    _api PUT "/merge_requests/${number}/merge" "$payload" >/dev/null
    ;;

  *) die "unknown verb '${verb}' (pr: open get update merge list)" ;;
esac
