#!/usr/bin/env bash
#
# GitLab issues adapter — verbs: list get comments create update comment attach
# set-status clear-status label-add label-remove assign unassign close reopen
# dep-add dep-remove dep-list dep-blocking.
# See ../../../references/adapter-contract.md.
# GitLab addresses issues by their per-project `iid` (what the contract calls --number),
# labels by name, and stores the body in `description`.
set -euo pipefail
ADAPTER_NAME="gitlab/issues"
# shellcheck source-path=SCRIPTDIR source=_common.sh
source "${0%/*}/_common.sh"

verb="${1:-}"; shift || true

# Base objects for --json (#253; ../_json.sh). One mapping per resource, so list,
# get and comments cannot drift apart. GitLab says `opened`, numbers issues by
# `iid`, and its notes carry no link: base_comment takes the issue's web URL.
# shellcheck disable=SC2016  # jq programs
ISSUE_JQ="$JSON_JQ"'
def base_issue: {
  number: (.iid | tostring), title: (.title // ""),
  state: (if .state == "closed" then "closed" else "open" end),
  labels: (.labels // []), author: (.author.username // null),
  created: (.created_at | utc), updated: (.updated_at | utc),
  comments: (.user_notes_count // null), url: (.web_url // null), body: (.description // "")
};
def base_comment($web): {
  id: (.id | tostring), author: (.author.username // null),
  created: (.created_at | utc), updated: (.updated_at | utc),
  url: (if $web == "" then null else "\($web)#note_\(.id)" end), body: (.body // "")
};'

# Comma-join the configured status/* label names into $status_csv (helper for
# set-status/clear-status). Reads LS_LABELS_JSON.
_status_names_csv() {
  local labels_json="${LS_LABELS_JSON:-}"; [ -n "$labels_json" ] || labels_json='{}'
  printf '%s' "$labels_json" | jq -r '[.status // {} | .[]] | join(",")'
}

case "$verb" in
  list)
    state="open"; limit="50"; labels=(); per_page=""; cursor=""
    while [ $# -gt 0 ]; do case "$1" in
      --state) state="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --label) labels+=("$2"); shift 2 ;;
      --per-page) per_page="$2"; shift 2 ;;
      --cursor) cursor="$2"; shift 2 ;;
      *) die "issues list: unknown arg '$1'" ;;
    esac; done
    # GitLab issue state is opened|closed; `all` means omit the filter.
    case "$state" in
      open)   q="state=opened" ;;
      closed) q="state=closed" ;;
      all)    q="" ;;
      *) die "issues list: --state must be open|closed|all" ;;
    esac
    # Percent-encoded before it goes in the URL: `status/to test` and friends
    # carry spaces and slashes, and curl refuses the whole URL over a raw space.
    if [ ${#labels[@]} -gt 0 ]; then
      enc=()
      for l in "${labels[@]}"; do enc+=("$(urlenc "$l")"); done
      old="$IFS"; IFS=,; q="${q:+$q&}labels=${enc[*]}"; IFS="$old"
    fi
    # Cursor paging (#262): one page per call, newest created first; see cursor_page.
    if [ -n "$per_page$cursor" ]; then
      json_mode || die "issues list: --per-page and --cursor need --json"
      per_page="$(per_page_arg "${per_page:-50}")" || exit 1
      _cursor_fetch() { _api GET "/issues?${q:+$q&}order_by=created_at&sort=desc&per_page=$2&page=$1";  }
      meta="$(page_meta_init)"
      FLIGHT_PAGE_META="$meta" cursor_page _cursor_fetch '.[]' '[(.created_at | utc), .iid]' "$per_page" "$cursor" \
          "gitlab $LS_API $LS_OWNER/$LS_REPO $q" x-total \
        | jq -c "$ISSUE_JQ"'base_issue | .body = null' | emit_list "$meta"
      exit 0
    fi
    # _paged_get honours --limit as a ceiling and pages underneath it, so a limit
    # above the server's cap returns what it says rather than one clamped page.
    if json_mode; then
      meta="$(page_meta_init)"
      FLIGHT_PAGE_META="$meta" _paged_get "/issues" "$q" "$limit" \
        | jq -c "$ISSUE_JQ"'base_issue | .body = null' | emit_list "$meta"
    else
      _paged_get "/issues" "$q" "$limit" \
        | jq -r '[(.iid|tostring), .title, ((.labels // []) | join(","))] | @tsv'
    fi
    ;;

  get)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues get: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues get: --number required"
    if json_mode; then
      _api GET "/issues/${number}" | jq -c "$ISSUE_JQ"'base_issue'
    else
      _api GET "/issues/${number}" \
        | jq -r '([(.iid|tostring), .title,
                    (.state | if . == "opened" then "open" else . end)] | @tsv),
                 "", (.description // "")'
    fi
    ;;

  comments)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues comments: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues comments: --number required"
    # One block per comment, oldest-first: `author⇥created_at` header, the raw
    # body, then a blank separator. System notes (label/state changes) are dropped.
    # GitLab returns notes newest-first, so reverse for oldest-first.
    # Paged to exhaustion: 100 is GitLab's per_page maximum and the thread renders
    # oldest-first, so an unpaged fetch drops the NEWEST notes — precisely the ones
    # "the later comment wins" depends on. System notes are dropped inside the
    # pager so they never displace a real comment.
    if json_mode; then
      web="$(_api GET "/issues/${number}" | jq -r '.web_url // ""')"
      _paged_get "/issues/${number}/notes" "sort=asc&order_by=created_at" "" \
        '.[] | select(.system | not)' \
        | jq -cs --arg web "$web" "$ISSUE_JQ"'map(base_comment($web))'
    else
      _paged_get "/issues/${number}/notes" "sort=asc&order_by=created_at" "" \
        '.[] | select(.system | not)' \
        | jq -r '([(.author.username // "?"), .created_at] | @tsv), (.body // ""), ""'
    fi
    ;;

  create)
    title=""; body=""; body_file=""; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --title)     title="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      --label)     labels+=("$2"); shift 2 ;;
      *) die "issues create: unknown arg '$1'" ;;
    esac; done
    [ -n "$title" ] || die "issues create: --title required"
    if [ -n "$body_file" ]; then
      [ -f "$body_file" ] || die "issues create: --body-file '$body_file' not found"
      payload="$(jq -n --arg t "$title" --rawfile b "$body_file" '{title:$t, description:$b}')"
    else
      payload="$(jq -n --arg t "$title" --arg b "$body" '{title:$t, description:$b}')"
    fi
    if [ ${#labels[@]} -gt 0 ]; then
      labels_load
      for n in "${labels[@]}"; do
        [ -n "$(label_id "$n")" ] \
          || die "issues create: label '$n' not found — create it first (labels create / bootstrapping-labels)"
      done
      old="$IFS"; IFS=,; csv="${labels[*]}"; IFS="$old"
      payload="$(printf '%s' "$payload" | jq --arg l "$csv" '. + {labels:$l}')"
    fi
    _api POST "/issues" "$payload" | jq -r '.iid'
    ;;

  update)
    number=""; title=""; body=""; body_file=""; have_title=0; have_body=0
    while [ $# -gt 0 ]; do case "$1" in
      --number)    number="$2"; shift 2 ;;
      --title)     title="$2"; have_title=1; shift 2 ;;
      --body)      body="$2"; have_body=1; shift 2 ;;
      --body-file) body_file="$2"; have_body=1; shift 2 ;;
      *) die "issues update: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues update: --number required"
    patch='{}'
    [ "$have_title" = 1 ] && patch="$(printf '%s' "$patch" | jq --arg t "$title" '. + {title:$t}')"
    if [ "$have_body" = 1 ]; then
      if [ -n "$body_file" ]; then
        [ -f "$body_file" ] || die "issues update: --body-file '$body_file' not found"
        patch="$(printf '%s' "$patch" | jq --rawfile b "$body_file" '. + {description:$b}')"
      else
        patch="$(printf '%s' "$patch" | jq --arg b "$body" '. + {description:$b}')"
      fi
    fi
    [ "$patch" = '{}' ] && die "issues update: nothing to change (pass --title and/or --body)"
    _api PUT "/issues/${number}" "$patch" >/dev/null
    ;;

  attach)
    number=""; file=""; name=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --file)   file="$2"; shift 2 ;;
      --name)   name="$2"; shift 2 ;;
      *) die "issues attach: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues attach: --number required"
    [ -f "$file" ]   || die "issues attach: --file '$file' not found"
    [ -n "$name" ]   || name="$(basename "$file")"
    # GitLab uploads are project-scoped, not issue-scoped; POST /uploads returns a
    # markdown ref + url. Embed the url in a comment/body to attach it to the issue.
    tmp="$(mktemp)"
    code="$(curl -sS -o "$tmp" -w '%{http_code}' -X POST \
      "${GL_HEADERS[@]}" \
      -F "file=@${file};filename=${name}" \
      "${PROJECT_API}/uploads")" || { rm -f "$tmp"; fail network "attach: curl failed"; }
    if [ "$code" -ge 400 ]; then
      msg="$(jq -r '(.message // .error // empty) | if type=="string" then . else tojson end' "$tmp" 2>/dev/null || true)"
      rm -f "$tmp"; http_fail "$code" "attach → HTTP $code${msg:+: $msg}"
    fi
    jq -r '.full_path // .url' "$tmp"; rm -f "$tmp"
    ;;

  comment)
    number=""; body=""; body_file=""
    while [ $# -gt 0 ]; do case "$1" in
      --number)    number="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      *) die "issues comment: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues comment: --number required"
    if [ -n "$body_file" ]; then
      [ -f "$body_file" ] || die "issues comment: --body-file '$body_file' not found"
      payload="$(jq -n --rawfile b "$body_file" '{body:$b}')"
    else
      payload="$(jq -n --arg b "$body" '{body:$b}')"
    fi
    if json_mode; then
      # The issue's URL first: once the note is posted, a failed read must not turn
      # into an error (a caller would post the comment again).
      web="$(_api GET "/issues/${number}" | jq -r '.web_url // ""')"
      note="$(_api POST "/issues/${number}/notes" "$payload")"
      jq -c --arg web "$web" "$ISSUE_JQ"'base_comment($web)' <<<"$note"
    else
      _api POST "/issues/${number}/notes" "$payload" >/dev/null
    fi
    ;;

  set-status)
    number=""; role=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --status) role="$2"; shift 2 ;;
      *) die "issues set-status: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues set-status: --number required"
    [ -n "$role" ]   || die "issues set-status: --status required"

    labels_json="${LS_LABELS_JSON:-}"; [ -n "$labels_json" ] || labels_json='{}'
    target_name="$(printf '%s' "$labels_json" | jq -r --arg r "$role" '.status[$r] // empty')"
    [ -n "$target_name" ] || die "set-status: role '$role' not found in labels.status config"
    [ -n "$(label_id "$target_name")" ] || die "set-status: label '$target_name' does not exist on the repo"

    # Single-status invariant: remove every OTHER managed status label, add target.
    # GitLab applies add_labels/remove_labels in one PUT (removing a label the
    # issue lacks is a harmless no-op).
    remove_csv="$(printf '%s' "$labels_json" | jq -r --arg t "$target_name" \
      '[.status // {} | .[] | select(type == "string") | select(. != $t)] | join(",")')"
    _api PUT "/issues/${number}" \
      "$(jq -n --arg a "$target_name" --arg r "$remove_csv" \
         '{add_labels:$a} + (if $r == "" then {} else {remove_labels:$r} end)')" >/dev/null
    ;;

  clear-status)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues clear-status: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues clear-status: --number required"
    remove_csv="$(_status_names_csv)"
    [ -n "$remove_csv" ] || exit 0
    _api PUT "/issues/${number}" "$(jq -n --arg r "$remove_csv" '{remove_labels:$r}')" >/dev/null
    ;;

  label-add)
    number=""; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --label)  labels+=("$2"); shift 2 ;;
      *) die "issues label-add: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues label-add: --number required"
    [ ${#labels[@]} -gt 0 ] || die "issues label-add: at least one --label required"
    labels_load
    for n in "${labels[@]}"; do
      [ -n "$(label_id "$n")" ] || die "issues label-add: label '$n' not found"
    done
    old="$IFS"; IFS=,; csv="${labels[*]}"; IFS="$old"
    _api PUT "/issues/${number}" "$(jq -n --arg a "$csv" '{add_labels:$a}')" >/dev/null
    ;;

  # Mirror of label-add. GitLab's remove_labels is idempotent — removing a
  # label the issue lacks is a harmless no-op — but an unknown label name is
  # still an error (catches typos).
  label-remove)
    number=""; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --label)  labels+=("$2"); shift 2 ;;
      *) die "issues label-remove: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues label-remove: --number required"
    [ ${#labels[@]} -gt 0 ] || die "issues label-remove: at least one --label required"
    labels_load
    for n in "${labels[@]}"; do
      [ -n "$(label_id "$n")" ] || die "issues label-remove: label '$n' not found"
    done
    old="$IFS"; IFS=,; csv="${labels[*]}"; IFS="$old"
    _api PUT "/issues/${number}" "$(jq -n --arg r "$csv" '{remove_labels:$r}')" >/dev/null
    ;;

  # Replace the issue's assignees with the given user(s). GitLab wants numeric
  # user ids, so each --user login is resolved via the instance-wide /users
  # lookup. `unassign` clears (assignee_ids:[0] is GitLab's documented "none").
  assign)
    number=""; users=()
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --user)   users+=("$2"); shift 2 ;;
      *) die "issues assign: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues assign: --number required"
    [ ${#users[@]} -gt 0 ] || die "issues assign: at least one --user required"
    ids="[]"
    for u in "${users[@]}"; do
      uid="$(curl -sS "${GL_HEADERS[@]}" "${LS_API%/}/users?username=$(urlenc "$u")" \
        | jq -r '.[0].id // empty')"
      [ -n "$uid" ] || die "issues assign: no GitLab user '${u}'"
      ids="$(printf '%s' "$ids" | jq -c --argjson id "$uid" '. + [$id]')"
    done
    _api PUT "/issues/${number}" "$(jq -n --argjson ids "$ids" '{assignee_ids:$ids}')" >/dev/null
    ;;

  unassign)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues unassign: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues unassign: --number required"
    _api PUT "/issues/${number}" '{"assignee_ids":[0]}' >/dev/null
    ;;

  close)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues close: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues close: --number required"
    _api PUT "/issues/${number}" "$(jq -n '{state_event:"close"}')" >/dev/null
    ;;

  reopen)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues reopen: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues reopen: --number required"
    _api PUT "/issues/${number}" "$(jq -n '{state_event:"reopen"}')" >/dev/null
    ;;

  dep-add|dep-remove|dep-list|dep-blocking)
    # Issue dependencies (FJ-271) as issue links. `blocks` / `is_blocked_by` links need GitLab
    # Premium or Ultimate: the Free tier (self-hosted CE included) refuses them, which is
    # reported as `unsupported` so the caller can fall back to comments. On that tier the
    # listing holds only relates_to links, which are filtered out here.
    number=""; by=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --by) by="$2"; shift 2 ;;
      *) die "issues $verb: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues $verb: --number required"
    case "$verb" in
      dep-add|dep-remove)
        case "$by" in ''|*[!0-9]*) die "issues $verb: --by needs an issue number" ;; esac ;;
    esac
    project_id="$(_api GET "" | jq -r '.id')"
    links="$(_api GET "/issues/${number}/links")"
    # rows LINK_TYPE — this project's links of that type, with the link id kept for removal.
    rows() {
      jq -c --argjson p "$project_id" --arg t "$1" '[.[] | select(.project_id == $p and .link_type == $t)
        | {number: (.iid | tostring), title: (.title // ""),
           state: (if .state == "closed" then "closed" else "open" end), link: .issue_link_id}]' <<<"$links"
    }
    case "$verb" in
      dep-list)     rows is_blocked_by | jq -c 'map(del(.link))' | dep_emit ;;
      dep-blocking) rows blocks | jq -c 'map(del(.link))' | dep_emit ;;
      dep-add)
        [ "$(rows is_blocked_by | jq --arg b "$by" 'map(select(.number == $b)) | length')" = 0 ] || exit 0
        # GitLab allows one link per issue pair (FJ-275): a pair already joined by relates_to (or
        # linked the other way) cannot take is_blocked_by too, so say which link is in the way.
        other="$(jq -r --argjson p "$project_id" --arg b "$by" '[.[] | select(.project_id == $p
          and (.iid | tostring) == $b) | .link_type] | first // empty' <<<"$links")"
        [ -z "$other" ] || fail unsupported "issues $number and $by already share a GitLab '$other' link, and GitLab allows one link per issue pair; cannot add is_blocked_by"
        tmp="$(mktemp)"
        code="$(_api_try POST "/issues/${number}/links" \
          "$(jq -cn --argjson p "$project_id" --arg b "$by" '{target_project_id: $p, target_issue_iid: $b, link_type: "is_blocked_by"}')" "$tmp")"
        msg="$(jq -r '(.message // .error // empty) | tostring' "$tmp" 2>/dev/null || true)"
        rm -f "$tmp"
        case "$code" in
          2??) ;;
          409) fail unsupported "GitLab refused an is_blocked_by link (HTTP 409${msg:+: $msg}); the pair likely already has a link of another type" ;;
          400|403|422) fail unsupported "GitLab refused an is_blocked_by link (HTTP $code${msg:+: $msg}); blocking links need GitLab Premium or Ultimate" ;;
          *) http_fail "$code" "POST /issues/${number}/links → HTTP $code${msg:+: $msg}" ;;
        esac
        ;;
      dep-remove)
        link="$(rows is_blocked_by | jq -r --arg b "$by" 'map(select(.number == $b)) | first | .link // empty')"
        [ -n "$link" ] || exit 0
        _api DELETE "/issues/${number}/links/${link}" >/dev/null
        ;;
    esac
    ;;

  *) die "unknown verb '${verb}' (issues: list get comments create update comment attach set-status clear-status label-add label-remove assign unassign close reopen dep-add dep-remove dep-list dep-blocking)" ;;
esac
