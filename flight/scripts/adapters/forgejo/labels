#!/usr/bin/env bash
#
# Forgejo labels adapter — verbs: list resolve create ensure edit delete.
# See ../../../references/adapter-contract.md.
set -euo pipefail
ADAPTER_NAME="forgejo/labels"
# shellcheck source-path=SCRIPTDIR source=_common.sh
source "$(cd "$(dirname "$0")" && pwd)/_common.sh"

verb="${1:-}"; shift || true

case "$verb" in
  list)
    _api GET "/labels?limit=100" | jq -r '.[] | [.name, .color, (.description // "")] | @tsv'
    ;;

  resolve)
    names=()
    while [ $# -gt 0 ]; do case "$1" in
      --name) names+=("$2"); shift 2 ;;
      *) die "labels resolve: unknown arg '$1'" ;;
    esac; done
    [ ${#names[@]} -gt 0 ] || die "labels resolve: at least one --name required"
    for n in "${names[@]}"; do
      printf '%s\t%s\n' "$n" "$(label_id "$n")"
    done
    ;;

  create)
    name=""; color=""; desc=""
    while [ $# -gt 0 ]; do case "$1" in
      --name)        name="$2"; shift 2 ;;
      --color)       color="$2"; shift 2 ;;
      --description) desc="$2"; shift 2 ;;
      *) die "labels create: unknown arg '$1'" ;;
    esac; done
    [ -n "$name" ]  || die "labels create: --name required"
    [ -n "$color" ] || die "labels create: --color required (e.g. #0088ff)"
    payload="$(jq -n --arg n "$name" --arg c "$color" --arg d "$desc" \
      '{name:$n, color:$c} + (if $d == "" then {} else {description:$d} end)')"
    _api POST "/labels" "$payload" | jq -r '.id'
    ;;

  ensure)
    name=""; color=""; desc=""
    while [ $# -gt 0 ]; do case "$1" in
      --name)        name="$2"; shift 2 ;;
      --color)       color="$2"; shift 2 ;;
      --description) desc="$2"; shift 2 ;;
      *) die "labels ensure: unknown arg '$1'" ;;
    esac; done
    [ -n "$name" ]  || die "labels ensure: --name required"
    [ -n "$color" ] || die "labels ensure: --color required"
    id="$(label_id "$name")"
    if [ -n "$id" ]; then printf '%s\n' "$id"; exit 0; fi
    payload="$(jq -n --arg n "$name" --arg c "$color" --arg d "$desc" \
      '{name:$n, color:$c} + (if $d == "" then {} else {description:$d} end)')"
    if created="$(_api POST "/labels" "$payload" | jq -r '.id')"; then
      printf '%s\n' "$created"
    else
      _LABELS_CACHE=""; id="$(label_id "$name")"; [ -n "$id" ] || exit 1; printf '%s\n' "$id"
    fi
    ;;

  edit)
    name=""; new_name=""
    while [ $# -gt 0 ]; do case "$1" in
      --name)     name="$2"; shift 2 ;;
      --new-name) new_name="$2"; shift 2 ;;
      *) die "labels edit: unknown arg '$1'" ;;
    esac; done
    [ -n "$name" ]     || die "labels edit: --name required"
    [ -n "$new_name" ] || die "labels edit: --new-name required"
    id="$(label_id "$name")"
    [ -n "$id" ] || die "labels edit: label '$name' not found"
    payload="$(jq -n --arg n "$new_name" '{name:$n}')"
    _api PATCH "/labels/$id" "$payload" | jq -r '.id'
    ;;

  delete)
    name=""; force=0
    while [ $# -gt 0 ]; do case "$1" in
      --name)  name="$2"; shift 2 ;;
      --force) force=1; shift ;;
      *) die "labels delete: unknown arg '$1'" ;;
    esac; done
    [ -n "$name" ] || die "labels delete: --name required"
    id="$(label_id "$name")"
    [ -n "$id" ] || die "labels delete: label '$name' not found"
    if [ "$force" -ne 1 ]; then
      # Issues AND pulls (no type= filter), any state; a full page means "50+".
      enc="$(printf '%s' "$name" | jq -sRr @uri)"
      in_use="$(_api GET "/issues?state=all&labels=${enc}&limit=50" | jq 'length')"
      [ "$in_use" -eq 0 ] || die "labels delete: '$name' is still on ${in_use}$([ "$in_use" -ge 50 ] && printf '+') issue(s)/PR(s); pass --force to delete it anyway"
    fi
    _api DELETE "/labels/$id" >/dev/null
    ;;

  *) die "unknown verb '${verb}' (labels: list resolve create ensure edit delete)" ;;
esac
