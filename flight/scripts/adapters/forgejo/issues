#!/usr/bin/env bash
#
# Forgejo issues adapter — verbs: list get comments create update comment attach
# set-status clear-status label-add label-remove assign unassign close reopen
# dep-add dep-remove dep-list dep-blocking.
# See ../../../references/adapter-contract.md.
set -euo pipefail
ADAPTER_NAME="forgejo/issues"
# shellcheck source-path=SCRIPTDIR source=_common.sh
source "${0%/*}/_common.sh"

verb="${1:-}"; shift || true

# Base objects for --json (#253; ../_json.sh). One mapping per resource, so list,
# get and comments cannot drift apart.
# shellcheck disable=SC2016  # jq programs
ISSUE_JQ="$JSON_JQ"'
def base_issue: {
  number: (.number | tostring), title: (.title // ""),
  state: (if .state == "closed" then "closed" else "open" end),
  labels: [.labels[]?.name], author: (.user.login // null),
  created: (.created_at | utc), updated: (.updated_at | utc),
  comments: (.comments // null), url: (.html_url // null), body: (.body // "")
};
def base_comment: {
  id: (.id | tostring), author: (.user.login // null),
  created: (.created_at | utc), updated: (.updated_at | utc),
  url: (.html_url // null), body: (.body // "")
};'

case "$verb" in
  list)
    state="open"; limit="50"; labels=(); per_page=""; cursor=""
    while [ $# -gt 0 ]; do case "$1" in
      --state) state="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --label) labels+=("$2"); shift 2 ;;
      --per-page) per_page="$2"; shift 2 ;;
      --cursor) cursor="$2"; shift 2 ;;
      *) die "issues list: unknown arg '$1'" ;;
    esac; done
    # Every interpolated value is percent-encoded: `status/to test` and friends
    # carry spaces and slashes, and curl refuses the whole URL over a raw space.
    q="type=issues&state=$(urlenc "$state")"
    if [ ${#labels[@]} -gt 0 ]; then
      enc=()
      for l in "${labels[@]}"; do enc+=("$(urlenc "$l")"); done
      old="$IFS"; IFS=,; q="${q}&labels=${enc[*]}"; IFS="$old"
    fi
    # Cursor paging (#262): one page per call, newest created first; see cursor_page.
    if [ -n "$per_page$cursor" ]; then
      json_mode || die "issues list: --per-page and --cursor need --json"
      per_page="$(per_page_arg "${per_page:-50}")" || exit 1
      _cursor_fetch() { _api GET "/issues?${q}&limit=$2&page=$1";  }
      meta="$(page_meta_init)"
      FLIGHT_PAGE_META="$meta" cursor_page _cursor_fetch '.[]' '[(.created_at | utc), .number]' "$per_page" "$cursor" \
          "forgejo $LS_API $LS_OWNER/$LS_REPO $q" x-total-count \
        | jq -c "$ISSUE_JQ"'base_issue | .body = null' | emit_list "$meta"
      exit 0
    fi
    # _paged_get honours --limit as a ceiling and pages underneath it, so a limit
    # above the server's cap returns what it says rather than one clamped page.
    if json_mode; then
      meta="$(page_meta_init)"
      FLIGHT_PAGE_META="$meta" _paged_get "/issues" "$q" "$limit" \
        | jq -c "$ISSUE_JQ"'base_issue | .body = null' | emit_list "$meta"
    else
      _paged_get "/issues" "$q" "$limit" \
        | jq -r '[(.number|tostring), .title, ([.labels[].name] | join(","))] | @tsv'
    fi
    ;;

  get)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues get: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues get: --number required"
    if json_mode; then
      _api GET "/issues/${number}" | jq -c "$ISSUE_JQ"'base_issue'
    else
      _api GET "/issues/${number}" \
        | jq -r '([(.number|tostring), .title, .state] | @tsv), "", (.body // "")'
    fi
    ;;

  comments)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues comments: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues comments: --number required"
    # One block per comment, oldest-first: `author⇥created_at` header, the raw
    # body, then a blank separator. Empty output (exit 0) means no comments.
    # Deliberately NOT paged: this endpoint ignores `limit` and `page` and returns
    # the whole thread (verified against a 53-comment issue), so a page-until-empty
    # loop would re-fetch the same rows forever. The GitHub and GitLab adapters do
    # page their comment endpoints, which cap for real.
    if json_mode; then
      _api GET "/issues/${number}/comments" | jq -c "$ISSUE_JQ"'map(base_comment)'
    else
      _api GET "/issues/${number}/comments" \
        | jq -r '.[] | ([(.user.login // "?"), .created_at] | @tsv), (.body // ""), ""'
    fi
    ;;

  create)
    title=""; body=""; body_file=""; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --title)     title="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      --label)     labels+=("$2"); shift 2 ;;
      *) die "issues create: unknown arg '$1'" ;;
    esac; done
    [ -n "$title" ] || die "issues create: --title required"
    if [ -n "$body_file" ]; then
      [ -f "$body_file" ] || die "issues create: --body-file '$body_file' not found"
      payload="$(jq -n --arg t "$title" --rawfile b "$body_file" '{title:$t, body:$b}')"
    else
      payload="$(jq -n --arg t "$title" --arg b "$body" '{title:$t, body:$b}')"
    fi
    if [ ${#labels[@]} -gt 0 ]; then
      ids=()
      labels_load
      for n in "${labels[@]}"; do
        id="$(label_id "$n")"
        [ -n "$id" ] || die "issues create: label '$n' not found — create it first (labels create / bootstrapping-labels)"
        ids+=("$id")
      done
      ids_json="$(printf '%s\n' "${ids[@]}" | jq -s 'map(tonumber)')"
      payload="$(printf '%s' "$payload" | jq --argjson l "$ids_json" '. + {labels:$l}')"
    fi
    _api POST "/issues" "$payload" | jq -r '.number'
    ;;

  update)
    number=""; title=""; body=""; body_file=""; have_title=0; have_body=0
    while [ $# -gt 0 ]; do case "$1" in
      --number)    number="$2"; shift 2 ;;
      --title)     title="$2"; have_title=1; shift 2 ;;
      --body)      body="$2"; have_body=1; shift 2 ;;
      --body-file) body_file="$2"; have_body=1; shift 2 ;;
      *) die "issues update: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues update: --number required"
    patch='{}'
    [ "$have_title" = 1 ] && patch="$(printf '%s' "$patch" | jq --arg t "$title" '. + {title:$t}')"
    if [ "$have_body" = 1 ]; then
      if [ -n "$body_file" ]; then
        [ -f "$body_file" ] || die "issues update: --body-file '$body_file' not found"
        patch="$(printf '%s' "$patch" | jq --rawfile b "$body_file" '. + {body:$b}')"
      else
        patch="$(printf '%s' "$patch" | jq --arg b "$body" '. + {body:$b}')"
      fi
    fi
    [ "$patch" = '{}' ] && die "issues update: nothing to change (pass --title and/or --body)"
    _api PATCH "/issues/${number}" "$patch" >/dev/null
    ;;

  attach)
    number=""; file=""; name=""; check=0
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --file)   file="$2"; shift 2 ;;
      --name)   name="$2"; shift 2 ;;
      --check)  check=1; shift ;;
      *) die "issues attach: unknown arg '$1'" ;;
    esac; done
    # --check (FJ-311): this backend can upload; nothing is sent.
    [ "$check" = 0 ] || exit 0
    [ -n "$number" ] || die "issues attach: --number required"
    [ -f "$file" ]   || die "issues attach: --file '$file' not found"
    [ -n "$name" ]   || name="$(basename "$file")"
    tmp="$(mktemp)"
    code="$(curl -sS -o "$tmp" -w '%{http_code}' -X POST \
      -H "Authorization: token ${LS_TOKEN}" \
      -F "attachment=@${file};filename=${name}" \
      "${REPO_API}/issues/${number}/assets")" || { rm -f "$tmp"; fail network "attach: curl failed"; }
    if [ "$code" -ge 400 ]; then
      msg="$(jq -r '.message // empty' "$tmp" 2>/dev/null || true)"; rm -f "$tmp"
      http_fail "$code" "attach → HTTP $code${msg:+: $msg}"
    fi
    jq -r '.browser_download_url' "$tmp"; rm -f "$tmp"
    ;;

  comment)
    number=""; body=""; body_file=""
    while [ $# -gt 0 ]; do case "$1" in
      --number)    number="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      *) die "issues comment: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues comment: --number required"
    if [ -n "$body_file" ]; then
      [ -f "$body_file" ] || die "issues comment: --body-file '$body_file' not found"
      payload="$(jq -n --rawfile b "$body_file" '{body:$b}')"
    else
      payload="$(jq -n --arg b "$body" '{body:$b}')"
    fi
    if json_mode; then
      _api POST "/issues/${number}/comments" "$payload" | jq -c "$ISSUE_JQ"'base_comment'
    else
      _api POST "/issues/${number}/comments" "$payload" >/dev/null
    fi
    ;;

  set-status)
    number=""; role=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --status) role="$2"; shift 2 ;;
      *) die "issues set-status: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues set-status: --number required"
    [ -n "$role" ]   || die "issues set-status: --status required"

    # The labels map (exported by the dispatcher). Default to {} without the
    # ${VAR:-{}} idiom — the first '}' there closes the expansion and appends a
    # stray '}', producing invalid JSON.
    labels_json="${LS_LABELS_JSON:-}"; [ -n "$labels_json" ] || labels_json='{}'

    # role → configured label name; the full status set is what we manage.
    target_name="$(printf '%s' "$labels_json" | jq -r --arg r "$role" '.status[$r] // empty')"
    [ -n "$target_name" ] || die "set-status: role '$role' not found in labels.status config"
    labels_load
    target_id="$(label_id "$target_name")"
    [ -n "$target_id" ] || die "set-status: label '$target_name' does not exist on the repo"

    # Remove every *other* managed status label currently on the issue, then add target.
    current_ids="$(_api GET "/issues/${number}" | jq -c '[.labels[].id]')"
    for id in $(_status_ids_on_issue "$labels_json" "$current_ids" "$target_name"); do
      _api DELETE "/issues/${number}/labels/${id}" >/dev/null
    done
    _api POST "/issues/${number}/labels" "$(jq -n --argjson id "$target_id" '{labels:[$id]}')" >/dev/null
    ;;

  clear-status)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues clear-status: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues clear-status: --number required"
    labels_json="${LS_LABELS_JSON:-}"; [ -n "$labels_json" ] || labels_json='{}'
    current_ids="$(_api GET "/issues/${number}" | jq -c '[.labels[].id]')"
    labels_load
    for id in $(_status_ids_on_issue "$labels_json" "$current_ids" ""); do
      _api DELETE "/issues/${number}/labels/${id}" >/dev/null
    done
    ;;

  label-add)
    number=""; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --label)  labels+=("$2"); shift 2 ;;
      *) die "issues label-add: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues label-add: --number required"
    [ ${#labels[@]} -gt 0 ] || die "issues label-add: at least one --label required"
    ids=()
    labels_load
    for n in "${labels[@]}"; do
      id="$(label_id "$n")"
      [ -n "$id" ] || die "issues label-add: label '$n' not found"
      ids+=("$id")
    done
    ids_json="$(printf '%s\n' "${ids[@]}" | jq -s 'map(tonumber)')"
    _api POST "/issues/${number}/labels" "$(jq -n --argjson l "$ids_json" '{labels:$l}')" >/dev/null
    ;;

  # Mirror of label-add. Idempotent: a label the issue doesn't carry is a
  # no-op success; an unknown label name is still an error (catches typos).
  label-remove)
    number=""; labels=()
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --label)  labels+=("$2"); shift 2 ;;
      *) die "issues label-remove: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues label-remove: --number required"
    [ ${#labels[@]} -gt 0 ] || die "issues label-remove: at least one --label required"
    ids=()
    labels_load
    for n in "${labels[@]}"; do
      id="$(label_id "$n")"
      [ -n "$id" ] || die "issues label-remove: label '$n' not found"
      ids+=("$id")
    done
    current_ids="$(_api GET "/issues/${number}" | jq -c '[.labels[].id]')"
    for id in "${ids[@]}"; do
      if printf '%s' "$current_ids" | jq -e --argjson id "$id" 'index($id) != null' >/dev/null; then
        _api DELETE "/issues/${number}/labels/${id}" >/dev/null
      fi
    done
    ;;

  # Replace the issue's assignees with the given user login(s). Repeatable
  # --user; `unassign` clears them all.
  assign)
    number=""; users=()
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --user)   users+=("$2"); shift 2 ;;
      *) die "issues assign: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues assign: --number required"
    [ ${#users[@]} -gt 0 ] || die "issues assign: at least one --user required"
    payload="$(printf '%s\n' "${users[@]}" | jq -R . | jq -s '{assignees:.}')"
    _api PATCH "/issues/${number}" "$payload" >/dev/null
    ;;

  unassign)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues unassign: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues unassign: --number required"
    _api PATCH "/issues/${number}" '{"assignees":[]}' >/dev/null
    ;;

  close)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues close: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues close: --number required"
    _api PATCH "/issues/${number}" "$(jq -n '{state:"closed"}')" >/dev/null
    ;;

  reopen)
    number=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      *) die "issues reopen: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues reopen: --number required"
    _api PATCH "/issues/${number}" "$(jq -n '{state:"open"}')" >/dev/null
    ;;

  dep-add|dep-remove|dep-list|dep-blocking)
    # Issue dependencies (FJ-271): "N is blocked by M", both issues in this repo. A repo with
    # dependencies switched off answers these endpoints with 404, which would read as a missing
    # issue, so the repo setting is checked first and reported as `unsupported`.
    number=""; by=""
    while [ $# -gt 0 ]; do case "$1" in
      --number) number="$2"; shift 2 ;;
      --by) by="$2"; shift 2 ;;
      *) die "issues $verb: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "issues $verb: --number required"
    case "$verb" in
      dep-add|dep-remove)
        case "$by" in ''|*[!0-9]*) die "issues $verb: --by needs an issue number" ;; esac ;;
    esac
    enabled="$(_api GET "" | jq -r '.internal_tracker.enable_issue_dependencies // false')"
    [ "$enabled" = true ] || fail unsupported "issue dependencies are switched off for ${LS_OWNER}/${LS_REPO}"
    # Only links whose other end is in this repo: the caller names issues by this tracker. One
    # page of 50 is enough; an issue with more blockers than that is not worth paging for.
    same_repo='[.[] | select((.repository.owner // "" | ascii_downcase) == ($o | ascii_downcase)
        and (.repository.name // "" | ascii_downcase) == ($r | ascii_downcase))
      | {number: (.number | tostring), title: (.title // ""),
         state: (if .state == "closed" then "closed" else "open" end)}]'
    case "$verb" in
      dep-list|dep-blocking)
        path=dependencies; [ "$verb" = dep-blocking ] && path=blocks
        _api GET "/issues/${number}/${path}?limit=50" \
          | jq -c --arg o "$LS_OWNER" --arg r "$LS_REPO" "$same_repo" | dep_emit
        ;;
      *)
        linked="$(_api GET "/issues/${number}/dependencies?limit=50" \
          | jq -r --arg o "$LS_OWNER" --arg r "$LS_REPO" --arg b "$by" "$same_repo"' | map(select(.number == $b)) | length')"
        if [ "$verb" = dep-add ] && [ "$linked" != 0 ]; then exit 0; fi
        if [ "$verb" = dep-remove ] && [ "$linked" = 0 ]; then exit 0; fi
        method=POST; [ "$verb" = dep-remove ] && method=DELETE
        _api "$method" "/issues/${number}/dependencies" \
          "$(jq -cn --arg o "$LS_OWNER" --arg r "$LS_REPO" --argjson i "$by" '{owner: $o, repo: $r, index: $i}')" >/dev/null
        ;;
    esac
    ;;

  *) die "unknown verb '${verb}' (issues: list get comments create update comment attach set-status clear-status label-add label-remove assign unassign close reopen dep-add dep-remove dep-list dep-blocking)" ;;
esac
