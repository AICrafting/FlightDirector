#!/usr/bin/env bash
#
# Forgejo pull-request adapter — verbs: open merge list.  ("MR" on GitLab.)
# See ../../../references/adapter-contract.md.
set -euo pipefail
ADAPTER_NAME="forgejo/pr"
# shellcheck source-path=SCRIPTDIR source=_common.sh
source "$(cd "$(dirname "$0")" && pwd)/_common.sh"

verb="${1:-}"; shift || true

case "$verb" in
  list)
    state="open"; head=""; base=""; limit=30
    while [ $# -gt 0 ]; do case "$1" in
      --state)  state="$2"; shift 2 ;;
      --head)   head="$2"; shift 2 ;;
      --base)   base="$2"; shift 2 ;;
      --limit)  limit="$2"; shift 2 ;;
      *) die "pr list: unknown arg '$1'" ;;
    esac; done
    # Forgejo has no `merged` state — a merged PR is a closed one with merged_at set,
    # so ask for closed and filter. --head/--base are client-side here (the endpoint
    # has no branch filter); the limit therefore bounds the *fetch*, not the matches.
    case "$state" in
      open)   api_state="open";   merged_only=0 ;;
      closed) api_state="closed"; merged_only=0 ;;
      merged) api_state="closed"; merged_only=1 ;;
      all)    api_state="all";    merged_only=0 ;;
      *) die "pr list: --state must be open|closed|merged|all" ;;
    esac
    _api GET "/pulls?state=${api_state}&limit=${limit}" \
      | jq -r --arg h "$head" --arg b "$base" --argjson m "$merged_only" '
          .[]
          | select($h == "" or .head.ref == $h)
          | select($b == "" or .base.ref == $b)
          | select($m == 0 or (.merged_at != null))
          | [ (.number|tostring),
              (if .merged_at != null then "merged" else .state end),
              .head.ref, .base.ref, .title ] | @tsv'
    ;;

  open)
    head=""; base=""; title=""; body=""; body_file=""
    while [ $# -gt 0 ]; do case "$1" in
      --head)      head="$2"; shift 2 ;;
      --base)      base="$2"; shift 2 ;;
      --title)     title="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      *) die "pr open: unknown arg '$1'" ;;
    esac; done
    [ -n "$base" ] || base="${LS_TRUNK:-}"
    [ -n "$head" ]  || die "pr open: --head required"
    [ -n "$base" ]  || die "pr open: --base required (and no code.trunkBranch configured)"
    [ -n "$title" ] || die "pr open: --title required"
    if [ -n "$body_file" ]; then
      [ -f "$body_file" ] || die "pr open: --body-file '$body_file' not found"
      payload="$(jq -n --arg h "$head" --arg b "$base" --arg t "$title" --rawfile body "$body_file" \
        '{head:$h, base:$b, title:$t, body:$body}')"
    else
      payload="$(jq -n --arg h "$head" --arg b "$base" --arg t "$title" --arg body "$body" \
        '{head:$h, base:$b, title:$t, body:$body}')"
    fi
    _api POST "/pulls" "$payload" | jq -r '[(.number|tostring), .html_url] | @tsv'
    ;;

  merge)
    number=""; strategy="merge"
    while [ $# -gt 0 ]; do case "$1" in
      --number)   number="$2"; shift 2 ;;
      --strategy) strategy="$2"; shift 2 ;;
      *) die "pr merge: unknown arg '$1'" ;;
    esac; done
    [ -n "$number" ] || die "pr merge: --number required"
    case "$strategy" in
      merge|squash|rebase) ;;
      *) die "pr merge: --strategy must be merge|squash|rebase" ;;
    esac
    _api POST "/pulls/${number}/merge" "$(jq -n --arg d "$strategy" '{Do:$d}')" >/dev/null
    ;;

  *) die "unknown verb '${verb}' (pr: open merge list)" ;;
esac
