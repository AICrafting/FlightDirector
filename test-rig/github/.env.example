# Flight GitHub test rig — copy to test-rig/github/.env (gitignored) and fill in.
# up.sh resolves this file from the MAIN repo root first (worktree-safe), then the rig dir.
# Values already exported in your shell win over this file.

# Throwaway repo the rig may write to (owner/repo). The rig only creates rig/* branches,
# [rig]-tagged issues/PRs and the seed labels + .github/workflows/ci.yml; it never touches
# the default branch. Use a repo you own for this purpose — nothing is hard-coded.
FLIGHT_GH_REPO=your-user/your-test-repo

# Token: fine-grained PAT restricted to that repo (or classic PAT).
# Minimum scopes: repo + workflow (classic), or for fine-grained: Contents, Issues,
# Pull requests, Actions, Workflows — read & write. Full list: flight/references/backends.md.
FLIGHT_GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API base — only change for GitHub Enterprise Server (https://ghe.example.com/api/v3)
#FLIGHT_GH_API=https://api.github.com
