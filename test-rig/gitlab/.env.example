# flight GitLab test rig — copy to test-rig/gitlab/.env (gitignored) and fill in.
# up.sh resolves this file from the MAIN repo root first (worktree-safe), then the rig dir.

# Token: classic personal/project access token with scope `api`, OR a fine-grained personal
# access token limited to the project with the per-resource permissions listed under
# "GitLab" in flight/references/backends.md (Project, Work Item, Label, Merge Request,
# Pipeline, Job, Markdown Upload, Repository). Tokens expire — check the date first.
FLIGHT_GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# API base. Self-managed: https://gitlab.example.com/api/v4
FLIGHT_GITLAB_API=https://gitlab.com/api/v4

# Project path (group/project; subgroups allowed: group/subgroup/project)
FLIGHT_GITLAB_PROJECT=your-group/your-test-project
