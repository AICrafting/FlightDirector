# flight Jira test rig — copy to test-rig/jira/.env (gitignored) and fill in.
# up.sh resolves this file from the MAIN repo root (worktree-safe).
# Auth is HTTP Basic email:api_token (classic Atlassian API token, not OAuth).

# Your Jira Cloud site
FLIGHT_JIRA_SITE=https://your-site.atlassian.net

# Atlassian account email the token belongs to
FLIGHT_JIRA_EMAIL=you@example.com

# API token: https://id.atlassian.com/manage-profile/security/api-tokens
FLIGHT_JIRA_TOKEN=ATATTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Project key the rig may write to (rig issues are marker-tagged and cleaned by down.sh)
FLIGHT_JIRA_PROJECT=KAN
