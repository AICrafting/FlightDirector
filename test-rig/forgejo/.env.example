# flight Forgejo test rig — copy to test-rig/forgejo/.env (gitignored) and adjust.
# Everything is optional: the rig runs a disposable local Forgejo in docker and mints
# its own admin token, so there are no credentials here. docker compose reads this
# file automatically; up.sh sources it too so both agree.

# Host port to publish Forgejo on (http://localhost:<port>)
RIG_PORT=3000

# Container image (pinned to the current major by default)
FORGEJO_IMAGE=code.forgejo.org/forgejo/forgejo:15
