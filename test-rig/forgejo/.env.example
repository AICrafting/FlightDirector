# Flight Forgejo test rig — copy to test-rig/forgejo/.env (gitignored) and adjust.
# Everything is optional: the rig runs a disposable local Forgejo in docker and mints
# its own admin token, so nothing here is a real credential. up.sh resolves this file
# from the MAIN repo root first (worktree-safe), then the rig dir, and passes the port
# and image through to docker compose explicitly.

# Host port to publish Forgejo on (http://localhost:<port>)
RIG_PORT=3000

# Container image (pinned to the current major by default)
FORGEJO_IMAGE=code.forgejo.org/forgejo/forgejo:16

# Admin user the rig provisions inside the container, and the test repo it creates under
# that user. Defaults are fine; override if they collide with something on your machine.
#FLIGHT_FORGEJO_USER=rig
#FLIGHT_FORGEJO_PASS=rigpass123
#FLIGHT_FORGEJO_EMAIL=rig@example.com
#FLIGHT_FORGEJO_REPO=widget
